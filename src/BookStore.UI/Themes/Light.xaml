<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F2FBF4" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#E4F6E8" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#102016" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#2F5E3F" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5F8A6A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#B9DEC3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#16833A" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0F6A2E" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#99102016" />
    <SolidColorBrush x:Key="WarmChromeBrush" Color="#102016" />
    <SolidColorBrush x:Key="WarmChromeAltBrush" Color="#16351F" />
    <LinearGradientBrush x:Key="BookstoreGreenBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#BBF7D0" Offset="0" />
        <GradientStop Color="#22C55E" Offset="0.46" />
        <GradientStop Color="#15803D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BookstorePageBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F7FFF9" Offset="0" />
        <GradientStop Color="#E9F8EE" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
