<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        The complete light palette. ThemeService swaps this whole dictionary for Dark.xaml, so every
        theme-varying brush must be declared in BOTH files under the same key. A brush that exists
        only here keeps its light value in dark mode, which is how the app ended up rendering
        near-white text on near-white input backgrounds.
    -->

    <!-- Surfaces and text -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F2FBF4" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#E4F6E8" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#102016" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#2F5E3F" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5F8A6A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#B9DEC3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#16833A" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0F6A2E" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#99102016" />

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D32" />
    <SolidColorBrush x:Key="WarningBrush" Color="#A15C00" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="InfoBrush" Color="#0F766E" />
    <SolidColorBrush x:Key="FocusBrush" Color="#22C55E" />

    <!-- Input and grid chrome. These replaced hard-coded hex values in the control styles. -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F7FFF9" />
    <SolidColorBrush x:Key="InputFocusBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GridAlternateRowBrush" Color="#F3FCF5" />
    <SolidColorBrush x:Key="GridSelectedRowBrush" Color="#DDFBE6" />
    <SolidColorBrush x:Key="GridHeaderBrush" Color="#DCF5E3" />
    <SolidColorBrush x:Key="GridHeaderTextBrush" Color="#102016" />

    <!-- Foreground for anything sitting on the accent/brand fill. -->
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="#052E16" />
    <SolidColorBrush x:Key="OnDangerTextBrush" Color="#FFFFFF" />

    <!-- Brand chrome -->
    <SolidColorBrush x:Key="WarmChromeBrush" Color="#102016" />
    <SolidColorBrush x:Key="WarmChromeAltBrush" Color="#16351F" />
    <SolidColorBrush x:Key="BrandOnChromeTextBrush" Color="#BBF7D0" />
    <SolidColorBrush x:Key="BrandDeepTextBrush" Color="#052E16" />
    <LinearGradientBrush x:Key="BookstoreGreenBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#BBF7D0" Offset="0" />
        <GradientStop Color="#22C55E" Offset="0.46" />
        <GradientStop Color="#15803D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BookstorePageBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F7FFF9" Offset="0" />
        <GradientStop Color="#E9F8EE" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
