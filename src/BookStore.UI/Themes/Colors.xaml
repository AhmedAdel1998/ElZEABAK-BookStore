<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Base semantic color tokens reused by all component dictionaries. -->
    <Color x:Key="AppBackgroundColor">#F2FBF4</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#E4F6E8</Color>
    <Color x:Key="PrimaryTextColor">#102016</Color>
    <Color x:Key="SecondaryTextColor">#2F5E3F</Color>
    <Color x:Key="MutedTextColor">#5F8A6A</Color>
    <Color x:Key="BorderColor">#B9DEC3</Color>
    <Color x:Key="AccentColor">#16833A</Color>
    <Color x:Key="AccentHoverColor">#0F6A2E</Color>
    <Color x:Key="SuccessColor">#2E7D32</Color>
    <Color x:Key="WarningColor">#A15C00</Color>
    <Color x:Key="DangerColor">#B91C1C</Color>
    <Color x:Key="InfoColor">#0F766E</Color>
    <Color x:Key="FocusColor">#22C55E</Color>
</ResourceDictionary>
