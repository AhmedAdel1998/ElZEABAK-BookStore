<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Base semantic color tokens reused by all component dictionaries. Brand hue is warm gold. -->
    <Color x:Key="AppBackgroundColor">#F4F7FB</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F8FAFC</Color>
    <Color x:Key="PrimaryTextColor">#18212F</Color>
    <Color x:Key="SecondaryTextColor">#48566A</Color>
    <Color x:Key="MutedTextColor">#748196</Color>
    <Color x:Key="BorderColor">#D9E1EC</Color>
    <Color x:Key="AccentColor">#B87514</Color>
    <Color x:Key="AccentHoverColor">#8F5A0C</Color>
    <Color x:Key="SuccessColor">#2E7D32</Color>
    <Color x:Key="WarningColor">#A15C00</Color>
    <Color x:Key="DangerColor">#B91C1C</Color>
    <Color x:Key="InfoColor">#0F766E</Color>
    <Color x:Key="FocusColor">#D49A2A</Color>
</ResourceDictionary>
