<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Base semantic color tokens reused by all component dictionaries. -->
    <Color x:Key="AppBackgroundColor">#F6F7F9</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F1F5F9</Color>
    <Color x:Key="PrimaryTextColor">#1F2933</Color>
    <Color x:Key="SecondaryTextColor">#64748B</Color>
    <Color x:Key="MutedTextColor">#94A3B8</Color>
    <Color x:Key="BorderColor">#D6DAE1</Color>
    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="AccentHoverColor">#1D4ED8</Color>
    <Color x:Key="SuccessColor">#15803D</Color>
    <Color x:Key="WarningColor">#B45309</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="InfoColor">#0284C7</Color>
    <Color x:Key="FocusColor">#F59E0B</Color>
</ResourceDictionary>
