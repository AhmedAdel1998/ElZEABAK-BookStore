<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Base semantic color tokens reused by all component dictionaries. -->
    <Color x:Key="AppBackgroundColor">#FFF8E7</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#FFF3C4</Color>
    <Color x:Key="PrimaryTextColor">#1E1711</Color>
    <Color x:Key="SecondaryTextColor">#745C2B</Color>
    <Color x:Key="MutedTextColor">#A58A49</Color>
    <Color x:Key="BorderColor">#E9D89A</Color>
    <Color x:Key="AccentColor">#D99A00</Color>
    <Color x:Key="AccentHoverColor">#B87800</Color>
    <Color x:Key="SuccessColor">#2E7D32</Color>
    <Color x:Key="WarningColor">#A15C00</Color>
    <Color x:Key="DangerColor">#B91C1C</Color>
    <Color x:Key="InfoColor">#0F766E</Color>
    <Color x:Key="FocusColor">#F2B705</Color>
</ResourceDictionary>
