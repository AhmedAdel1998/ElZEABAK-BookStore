<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        Segoe MDL2 Assets code points. These were single ASCII letters, which rendered literally: a
        SearchBox showed the word or letter next to its placeholder rather than a magnifier.
    -->
    <sys:String x:Key="IconSearch">&#xE721;</sys:String>
    <sys:String x:Key="IconInfo">&#xE946;</sys:String>
    <sys:String x:Key="IconWarning">&#xE7BA;</sys:String>
    <sys:String x:Key="IconError">&#xE783;</sys:String>
    <sys:String x:Key="IconSuccess">&#xE73E;</sys:String>
    <sys:String x:Key="IconQuestion">&#xE9CE;</sys:String>
    <sys:String x:Key="IconSettings">&#xE713;</sys:String>
    <sys:String x:Key="IconLogout">&#xE7E8;</sys:String>
</ResourceDictionary>
