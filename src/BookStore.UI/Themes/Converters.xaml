<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:BookStore.UI.Converters">
    <!--
        Converters live in their own dictionary and are merged FIRST, before the style dictionaries.
        A StaticResource lookup inside a merged dictionary cannot see entries declared directly on the
        application's own ResourceDictionary, only those from dictionaries merged ahead of it. Control
        templates in Styles/*.xaml reference these converters, so declaring them in App.xaml threw
        "Cannot find resource named 'IconGlyphConverter'" the moment a templated button was realised.
    -->
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <converters:CurrencyValueConverter x:Key="CurrencyConverter" />
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    <converters:MinWidthToVisibilityConverter x:Key="MinWidthToVisibilityConverter" />
    <converters:IconGlyphConverter x:Key="IconGlyphConverter" />
    <converters:EmptyCollectionToVisibilityConverter x:Key="EmptyCollectionToVisibilityConverter" />
    <converters:LocalizeConverter x:Key="LocalizeConverter" />
    <converters:EnumDisplayConverter x:Key="EnumDisplayConverter" />
</ResourceDictionary>
