<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="ApplicationFontFamily">Segoe UI</FontFamily>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ApplicationFontFamily}" />
        <Setter Property="FlowDirection" Value="{DynamicResource AppFlowDirection}" />
        <Setter Property="TextAlignment" Value="{DynamicResource AppTextAlignment}" />
    </Style>
</ResourceDictionary>
