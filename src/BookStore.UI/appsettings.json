{
  "ConnectionStrings": {
    "BookStoreDb": "Data Source=Database/bookstore.db"
  },
  "Application": {
    "Store": {
      "Name": "EL ZEABAK BookStore",
      "Currency": "EGP",
      "TaxRate": 0.14
    },
    "Printer": {
      "Name": ""
    },
    "Backup": {
      "Enabled": true,
      "Folder": "Backups"
    },
    "Logging": {
      "Folder": "Logs"
    },
    "UserInterface": {
      "Theme": "Light",
      "Language": "en-US"
    },
    "Authentication": {
      "MaxFailedLoginAttempts": 5,
      "LockoutMinutes": 15,
      "SessionTimeoutMinutes": 30,
      "RememberMeDays": 30
    },
    "Barcode": {
      "DefaultType": "Code128",
      "Prefix": "BK",
      "StartingNumber": 100000,
      "Length": 12,
      "LabelWidthMm": 50,
      "LabelHeightMm": 25,
      "PrinterName": "",
      "ScanTimeoutMilliseconds": 80,
      "AutomaticGenerationEnabled": true,
      "ManualGenerationEnabled": true
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/bookstore-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}
