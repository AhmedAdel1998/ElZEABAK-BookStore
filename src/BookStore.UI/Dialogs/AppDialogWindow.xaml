<Window x:Class="BookStore.UI.Dialogs.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BookStore.UI.Controls"
        Width="480"
        MinWidth="380"
        SizeToContent="Height"
        MinHeight="180"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FlowDirection="{DynamicResource AppFlowDirection}"
        Background="{DynamicResource SurfaceBrush}">
    <!--
        Replaces System.Windows.MessageBox for confirmations, warnings and errors. The native box drew
        OS chrome with no theme, no dark mode and no application font, and its Yes/No/OK labels came
        from the Windows locale - so they stayed English in Arabic mode on an English Windows install.
    -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <TextBlock x:Name="IconGlyph"
                       DockPanel.Dock="Left"
                       Margin="0,0,12,0"
                       VerticalAlignment="Top"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="22" />
            <TextBlock x:Name="TitleText"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       TextWrapping="Wrap" />
        </DockPanel>

        <TextBlock x:Name="MessageText"
                   Grid.Row="1"
                   Margin="0,14,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap" />

        <StackPanel x:Name="ButtonRow"
                    Grid.Row="2"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <controls:SecondaryButton x:Name="SecondaryAction"
                                      MinWidth="104"
                                      Margin="0,0,10,0"
                                      IsCancel="True"
                                      Click="OnSecondaryClicked" />
            <controls:PrimaryButton x:Name="PrimaryAction"
                                    MinWidth="104"
                                    IsDefault="True"
                                    Click="OnPrimaryClicked" />
        </StackPanel>
    </Grid>
</Window>
