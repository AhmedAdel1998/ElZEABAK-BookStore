<Window x:Class="BookStore.UI.Dialogs.CrashDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource App.Title}"
        Width="520"
        SizeToContent="Height"
        MinHeight="220"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FlowDirection="{DynamicResource AppFlowDirection}"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   Text="{DynamicResource Crash.UnexpectedError}"
                   TextWrapping="Wrap" />

        <!-- The correlation id is the join key between what the user sees and the full exception
             this same identifier is logged next to, so support can locate the failure without
             asking the user to describe what happened. -->
        <TextBlock Grid.Row="1"
                   Margin="0,12,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource SecondaryTextBrush}">
            <Run Text="{DynamicResource Crash.Reference}" />
            <Run FontFamily="Consolas" FlowDirection="LeftToRight" Text="{Binding CorrelationId, Mode=OneWay}" />
        </TextBlock>

        <Expander Grid.Row="2"
                  Margin="0,12,0,0"
                  Header="{DynamicResource Crash.TechnicalDetails}"
                  Foreground="{DynamicResource PrimaryTextBrush}">
            <ScrollViewer Height="140"
                          Margin="0,8,0,0"
                          VerticalScrollBarVisibility="Auto">
                <TextBox IsReadOnly="True"
                         TextWrapping="NoWrap"
                         FlowDirection="LeftToRight"
                         FontFamily="Consolas"
                         FontSize="11"
                         Background="{DynamicResource SurfaceAltBrush}"
                         BorderThickness="1"
                         BorderBrush="{DynamicResource BorderBrush}"
                         Text="{Binding Details, Mode=OneWay}" />
            </ScrollViewer>
        </Expander>

        <StackPanel Grid.Row="3"
                    Margin="0,20,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="130"
                    Padding="10,6"
                    Content="{DynamicResource Crash.CopyDetails}"
                    Click="OnCopyDetailsClicked" />
            <Button Width="90"
                    Margin="10,0,0,0"
                    Padding="10,6"
                    IsDefault="True"
                    IsCancel="True"
                    Content="{DynamicResource Crash.Ok}"
                    Click="OnCloseClicked" />
        </StackPanel>
    </Grid>
</Window>
