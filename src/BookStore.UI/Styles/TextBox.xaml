<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:BookStore.UI.Controls">
    <!-- Shared text input template. Validation states come from WPF validation and optional ErrorMessage. -->
    <Style x:Key="AppTextInputStyle" TargetType="{x:Type controls:TextInputBox}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TextInputBox}">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerRadiusMedium}" />
                        <DockPanel Margin="{TemplateBinding Padding}">
                            <TextBlock DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Text="{TemplateBinding Icon}" />
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                                <TextBlock x:Name="PlaceholderText"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           IsHitTestVisible="False"
                                           Text="{TemplateBinding Placeholder}"
                                           Visibility="Collapsed" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Root" Property="Background" Value="#F7FFF9" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:TextInputBox}" BasedOn="{StaticResource AppTextInputStyle}" />
    <Style TargetType="{x:Type controls:SearchBox}" BasedOn="{StaticResource AppTextInputStyle}" />
    <Style TargetType="{x:Type controls:NumericTextBox}" BasedOn="{StaticResource AppTextInputStyle}" />
    <Style TargetType="{x:Type controls:CurrencyTextBox}" BasedOn="{StaticResource AppTextInputStyle}" />
    <Style TargetType="{x:Type controls:BarcodeTextBox}" BasedOn="{StaticResource AppTextInputStyle}" />
    <Style TargetType="{x:Type controls:ISBNTextBox}" BasedOn="{StaticResource AppTextInputStyle}" />
    <Style TargetType="{x:Type controls:EmailTextBox}" BasedOn="{StaticResource AppTextInputStyle}" />
    <Style TargetType="{x:Type controls:PhoneTextBox}" BasedOn="{StaticResource AppTextInputStyle}" />

    <Style TargetType="{x:Type controls:PasswordInputBox}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PasswordInputBox}">
                    <Border MinHeight="{TemplateBinding MinHeight}"
                            Padding="10,6"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusMedium}">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Text="{TemplateBinding Placeholder}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:AppDatePicker}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>

    <Style TargetType="{x:Type controls:AppComboBox}">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>

    <Style TargetType="{x:Type controls:AutoCompleteBox}" BasedOn="{StaticResource {x:Type controls:AppComboBox}}" />

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Background" Value="#F7FFF9" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FlowDirection" Value="{DynamicResource AppFlowDirection}" />
        <Setter Property="TextAlignment" Value="{DynamicResource AppTextAlignment}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    </Style>
</ResourceDictionary>
