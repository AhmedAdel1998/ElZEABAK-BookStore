<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:BookStore.UI.Controls">
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2" Stroke="{DynamicResource FocusBrush}" StrokeDashArray="2 2" StrokeThickness="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolbarStyle" TargetType="DockPanel">
        <Setter Property="Height" Value="{DynamicResource ToolbarHeight}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>

    <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style x:Key="PanelBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="18" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
        <Setter Property="Effect" Value="{DynamicResource CardShadow}" />
    </Style>

    <Style TargetType="{x:Type controls:EmptyStateView}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:EmptyStateView}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{TemplateBinding Title}" />
                        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="{TemplateBinding Message}" TextWrapping="Wrap" />
                        <ContentPresenter Margin="0,12,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type controls:NoDataView}" BasedOn="{StaticResource {x:Type controls:EmptyStateView}}" />

    <Style TargetType="{x:Type controls:BarcodePreviewControl}">
        <!-- A mirrored barcode does not scan, so this surface stays left-to-right in every language. -->
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:BarcodePreviewControl}">
                    <Border Padding="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusLarge}" Effect="{DynamicResource CardShadow}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{TemplateBinding ProductTitle}" />
                            <Border Margin="0,12,0,8" Padding="10" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <ItemsControl Height="80">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" Columns="24" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <Rectangle Fill="#111827" />
                                        <Rectangle Fill="White" />
                                        <Rectangle Fill="#111827" />
                                        <Rectangle Fill="#111827" />
                                        <Rectangle Fill="White" />
                                        <Rectangle Fill="#111827" />
                                        <Rectangle Fill="White" />
                                        <Rectangle Fill="#111827" />
                                        <Rectangle Fill="#111827" />
                                        <Rectangle Fill="White" />
                                        <Rectangle Fill="#111827" />
                                        <Rectangle Fill="White" />
                                        <Rectangle Fill="#111827" />
                                        <Rectangle Fill="#111827" />
                                        <Rectangle Fill="White" />
                                        <Rectangle Fill="#111827" />
                                        <Rectangle Fill="White" />
                                        <Rectangle Fill="#111827" />
                                        <Rectangle Fill="#111827" />
                                        <Rectangle Fill="White" />
                                        <Rectangle Fill="#111827" />
                                        <Rectangle Fill="White" />
                                        <Rectangle Fill="#111827" />
                                        <Rectangle Fill="#111827" />
                                    </ItemsControl>
                                    <TextBlock HorizontalAlignment="Center" FontFamily="Consolas" Foreground="#111827" Text="{TemplateBinding BarcodeValue}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Format}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
