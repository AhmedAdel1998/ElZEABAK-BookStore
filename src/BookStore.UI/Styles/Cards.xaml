<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:BookStore.UI.Controls">
    <!-- Card template for metrics, statistics, quick actions, and information panels. -->
    <Style TargetType="{x:Type controls:AppCard}">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AppCard}">
                    <Border x:Name="Root"
                            Padding="18"
                            Background="{DynamicResource PanelGradientBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusLarge}"
                            Effect="{DynamicResource CardShadow}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left"
                                        Width="36"
                                        Height="36"
                                        Margin="0,0,12,0"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource CornerRadiusMedium}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Icon, RelativeSource={RelativeSource AncestorType=controls:AppCard}, Converter={StaticResource IconGlyphConverter}}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Text="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IconGlyphConverter}}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" Text="{TemplateBinding Title}" />
                                    <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Text="{TemplateBinding Subtitle}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Margin="0,12,0,0" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{TemplateBinding Value}" Text="{TemplateBinding Value}" />
                            <ContentPresenter Margin="0,12,0,0" />
                            <ContentPresenter Margin="0,12,0,0" Content="{TemplateBinding Footer}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1.01"
                                                     Duration="0:0:0.14" />
                                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1.01"
                                                     Duration="0:0:0.14" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1"
                                                     Duration="0:0:0.16" />
                                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1"
                                                     Duration="0:0:0.16" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
