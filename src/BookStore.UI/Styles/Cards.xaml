<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:BookStore.UI.Controls">
    <!-- Card template for metrics, statistics, quick actions, and information panels. -->
    <Style TargetType="{x:Type controls:AppCard}">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AppCard}">
                    <Border Padding="18"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource CornerRadiusLarge}"
                            Effect="{DynamicResource CardShadow}">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left"
                                        Width="36"
                                        Height="36"
                                        Margin="0,0,12,0"
                                        Background="{DynamicResource SurfaceAltBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource CornerRadiusMedium}">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource AccentBrush}" Text="{TemplateBinding Icon}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{TemplateBinding Title}" />
                                    <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="{TemplateBinding Subtitle}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Margin="0,12,0,0" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{TemplateBinding Value}" />
                            <ContentPresenter Margin="0,12,0,0" />
                            <ContentPresenter Margin="0,12,0,0" Content="{TemplateBinding Footer}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
