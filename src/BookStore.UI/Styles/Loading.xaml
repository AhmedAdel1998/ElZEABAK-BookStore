<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:BookStore.UI.Controls">
    <Style TargetType="{x:Type controls:LoadingSpinner}" />

    <Style TargetType="{x:Type controls:LoadingOverlay}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:LoadingOverlay}">
                    <Border Background="{DynamicResource OverlayBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:LoadingSpinner />
                            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" Foreground="White" Text="{TemplateBinding Message}" />
                            <ContentPresenter Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsBusy" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type controls:BusyIndicator}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:BusyIndicator}">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar Width="80" Height="6" IsIndeterminate="True" />
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:SkeletonLoader}">
        <Setter Property="MinHeight" Value="18" />
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    </Style>
</ResourceDictionary>
