<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Reusable dialog shell style for custom dialog windows added by future modules. -->
    <Style x:Key="DialogPanelStyle" TargetType="Border">
        <Setter Property="Width" Value="420" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
        <Setter Property="Effect" Value="{DynamicResource PopupShadow}" />
    </Style>
</ResourceDictionary>
