<UserControl x:Class="BookStore.UI.Views.Backup.BackupRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BookStore.UI.Controls">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <controls:AppCard MaxWidth="760" HorizontalAlignment="Left" Title="Restore Backup" Icon="Restore">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="{Binding SelectedBackup.FileName}" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding SelectedBackup.CreatedAt}" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding SelectedBackup.ChecksumSha256}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,18,0,6" Text="Restore confirmation" />
                    <TextBlock Margin="0,0,0,6"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource WarningBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding RequiredConfirmationText}" />
                    <controls:TextInputBox Placeholder="Restore confirmation"
                                           AutomationProperties.Name="Restore confirmation"
                                           Text="{Binding ConfirmationText, UpdateSourceTrigger=PropertyChanged}" />
                    <controls:DangerButton Margin="0,14,0,0" HorizontalAlignment="Left" Command="{Binding RestoreCommand}" Content="Restore" Icon="Restore" />
                </StackPanel>
            </controls:AppCard>
        </ScrollViewer>

        <!-- A sibling of the ScrollViewer inside a Grid, so it actually covers the content. As a
             StackPanel child it rendered as a strip below the button and blocked nothing. -->
        <controls:LoadingOverlay IsBusy="{Binding IsBusy}" Message="Restoring database..." />
    </Grid>
</UserControl>
