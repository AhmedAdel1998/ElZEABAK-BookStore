<UserControl x:Class="BookStore.UI.Views.Categories.CategoryDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BookStore.UI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <controls:AppCard Grid.Row="0"
                              MaxWidth="620"
                              HorizontalAlignment="Left"
                              Title="Category Details"
                              Subtitle="{Binding Message, Converter={StaticResource LocalizeConverter}}"
                              Icon="Categories">
                <StackPanel DataContext="{Binding Category}">
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{Binding Name}" />
                    <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Description, Converter={StaticResource LocalizeConverter}}" TextWrapping="Wrap" />
                    <Separator Margin="0,16" />
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Status" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding Status}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Product Count" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding ProductCount}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Created" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,12">
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Updated" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </controls:AppCard>

            <StackPanel Grid.Row="1" MaxWidth="620" Margin="0,14,0,0" HorizontalAlignment="Left" Orientation="Horizontal">
                <controls:SecondaryButton Margin="0,0,8,0" Command="{Binding BackCommand}" Content="Back" Icon="Back" />
                <controls:PrimaryButton Command="{Binding EditCommand}" Content="Edit" Icon="Edit" />
            </StackPanel>

            <controls:LoadingOverlay Grid.RowSpan="2" IsBusy="{Binding IsBusy}" Message="Loading category..." />
        </Grid>
    </ScrollViewer>
</UserControl>
