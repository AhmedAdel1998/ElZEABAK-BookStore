<UserControl x:Class="BookStore.UI.Views.Reports.ReportGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BookStore.UI.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{Binding Title}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <controls:ReportDateRangeControl Margin="0,0,8,0" SelectedPreset="{Binding SelectedPreset}" StartDate="{Binding StartDate}" EndDate="{Binding EndDate}" />
                <controls:PrimaryButton Command="{Binding RefreshCommand}" Content="Refresh" Icon="Refresh" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <DataGrid ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="True"
                      AutoGeneratingColumn="OnAutoGeneratingColumn"
                      HorizontalScrollBarVisibility="Auto"
                      IsReadOnly="True"
                      CanUserAddRows="False" />
            <controls:NoDataView Title="{DynamicResource Report.NoRows}"
                                 Message="{Binding EmptyMessage, Converter={StaticResource LocalizeConverter}}"
                                 Visibility="{Binding Rows.Count, Converter={StaticResource EmptyCollectionToVisibilityConverter}}" />
            <controls:LoadingOverlay IsBusy="{Binding IsBusy}" Message="Loading report..." />
        </Grid>
    </Grid>
</UserControl>
