<UserControl x:Class="BookStore.UI.Views.Reports.ReportGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BookStore.UI.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{Binding Title}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <controls:ReportDateRangeControl Margin="0,0,8,0" SelectedPreset="{Binding SelectedPreset}" StartDate="{Binding StartDate}" EndDate="{Binding EndDate}" />
                <controls:PrimaryButton Command="{Binding RefreshCommand}" Content="Refresh" Icon="R" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False" />
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding EmptyMessage}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <controls:LoadingOverlay IsBusy="{Binding IsBusy}" Message="Loading report..." />
        </Grid>
    </Grid>
</UserControl>
