<UserControl x:Class="BookStore.UI.Views.Receipts.PrinterTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Printer Test" />
            <ComboBox Width="320" Margin="0,12,0,0" HorizontalAlignment="Left" ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Width="140" Margin="0,12,0,0" HorizontalAlignment="Left" Command="{Binding LoadPrintersCommand}" Content="Refresh" />
            <Button Width="140" Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding TestPrintCommand}" Content="Test Print" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
