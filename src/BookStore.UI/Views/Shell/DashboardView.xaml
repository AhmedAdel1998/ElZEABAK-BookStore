<UserControl x:Class="BookStore.UI.Views.Shell.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1050">
    <UserControl.Resources>
        <Style x:Key="DashboardPanelStyle" TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{DynamicResource PanelGradientBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Effect" Value="{DynamicResource CardShadow}" />
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource DashboardPanelStyle}">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.96" To="1" Duration="0:0:0.35" />
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.96" To="1" Duration="0:0:0.35" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer FlowDirection="{DynamicResource AppFlowDirection}" VerticalScrollBarVisibility="Auto">
        <Grid FlowDirection="{DynamicResource AppFlowDirection}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="24"
                    Background="{DynamicResource HeroPanelBrush}"
                    BorderBrush="{DynamicResource ChromeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Effect="{DynamicResource CardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="{Binding Title}" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="14"
                                   Foreground="#DDE7F3"
                                   Text="{Binding Subtitle}" />
                        <TextBlock Margin="0,10,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource BrandOnChromeTextBrush}"
                                   Text="{Binding LastUpdated}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                        <Button MinWidth="110"
                                Height="38"
                                HorizontalAlignment="Right"
                                Background="{DynamicResource BookstoreBrandBrush}"
                                Foreground="{DynamicResource OnAccentTextBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                Command="{Binding RefreshCommand}"
                                Content="{DynamicResource Shell.Refresh}" />
                        <Border Width="220"
                                Margin="0,18,0,0"
                                Padding="14"
                                Background="#261A202A"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid Height="82">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Height="34" VerticalAlignment="Bottom" Fill="{DynamicResource BrandOnChromeTextBrush}" RadiusX="3" RadiusY="3" />
                                <Rectangle Grid.Column="1" Height="52" Margin="8,0" VerticalAlignment="Bottom" Fill="{DynamicResource DataVizTealBrush}" RadiusX="3" RadiusY="3" />
                                <Rectangle Grid.Column="2" Height="44" Margin="8,0" VerticalAlignment="Bottom" Fill="{DynamicResource DataVizBlueBrush}" RadiusX="3" RadiusY="3" />
                                <Rectangle Grid.Column="3" Height="68" Margin="8,0" VerticalAlignment="Bottom" Fill="{DynamicResource BrandOnChromeTextBrush}" RadiusX="3" RadiusY="3" />
                                <Rectangle Grid.Column="4" Height="58" Margin="8,0" VerticalAlignment="Bottom" Fill="{DynamicResource DataVizTealBrush}" RadiusX="3" RadiusY="3" />
                                <Rectangle Grid.Column="5" Height="76" Margin="8,0,0,0" VerticalAlignment="Bottom" Fill="{DynamicResource BookstoreBrandBrush}" RadiusX="3" RadiusY="3" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl Grid.Row="1"
                          Margin="0,18,0,0"
                          ItemsSource="{Binding Metrics}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,12,0"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding Command}">
                            <Border Style="{StaticResource MetricCardStyle}">
                                <Grid FlowDirection="{DynamicResource AppFlowDirection}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="13"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Text="{Binding Title}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   FontSize="26"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   Text="{Binding Value}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Text="{Binding Hint}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Width="40"
                                            Height="40"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <!-- A Latin initial is meaningless in an Arabic UI, so the
                                             tile shows the same semantic glyph the rest of the app
                                             uses. -->
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Text="{Binding Icon, Converter={StaticResource IconGlyphConverter}}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="0.85*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource DashboardPanelStyle}">
                    <StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="{DynamicResource Dashboard.OperationsPulse}" />
                        <Grid Margin="0,18,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!--  LastChildFill off so the reading docks to the edge instead of butting against the label ("Inventory health0%").  -->
                            <DockPanel FlowDirection="{DynamicResource AppFlowDirection}" LastChildFill="False">
                                <TextBlock Text="{DynamicResource Dashboard.InventoryHealth}" />
                                <TextBlock DockPanel.Dock="Right"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="{Binding InventoryHealthText}" />
                            </DockPanel>
                            <ProgressBar Grid.Row="1"
                                         Height="16"
                                         Margin="0,8,0,16"
                                         Maximum="100"
                                         Value="{Binding InventoryHealthPercent}" />
                            <DockPanel Grid.Row="2" FlowDirection="{DynamicResource AppFlowDirection}" LastChildFill="False">
                                <TextBlock Text="{DynamicResource Dashboard.SalesMomentum}" />
                                <TextBlock DockPanel.Dock="Right"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="{Binding SalesMomentumText}" />
                            </DockPanel>
                            <ProgressBar Grid.Row="3"
                                         Height="16"
                                         Margin="0,8,0,0"
                                         Maximum="100"
                                         Value="{Binding SalesMomentumPercent}" />
                        </Grid>

                        <TextBlock Margin="0,22,0,10"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Dashboard.LiveSignals}" />
                        <ItemsControl ItemsSource="{Binding Activity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="12"
                                            Background="{DynamicResource SurfaceAltBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <DockPanel FlowDirection="{DynamicResource AppFlowDirection}">
                                            <TextBlock DockPanel.Dock="Right"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Text="{Binding Value}" />
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Text="{Binding Detail}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource DashboardPanelStyle}">
                    <StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="{DynamicResource Dashboard.QuickActions}" />
                        <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding QuickActions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,0,10"
                                            Padding="14"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding Command}">
                                        <DockPanel FlowDirection="{DynamicResource AppFlowDirection}">
                                            <TextBlock DockPanel.Dock="Right"
                                                       VerticalAlignment="Center"
                                                       FontSize="18"
                                                       Text=">" />
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Text="{Binding Hint}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
