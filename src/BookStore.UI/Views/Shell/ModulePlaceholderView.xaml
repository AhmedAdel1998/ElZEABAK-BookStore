<UserControl x:Class="BookStore.UI.Views.Shell.ModulePlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Padding="24" Background="{DynamicResource SurfaceBrush}" CornerRadius="6">
            <StackPanel>
                <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding Title}" />
                <TextBlock Margin="0,12,0,0" FontSize="15" Foreground="{DynamicResource PrimaryTextBrush}" Opacity="0.75" Text="{Binding Description, Converter={StaticResource LocalizeConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
