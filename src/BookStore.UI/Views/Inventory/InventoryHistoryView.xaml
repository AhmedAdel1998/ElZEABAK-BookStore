<UserControl x:Class="BookStore.UI.Views.Inventory.InventoryHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BookStore.UI.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Stock Ledger" />
            <controls:SecondaryButton DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Content="Refresh" Icon="R" />
        </DockPanel>
        <Border Grid.Row="1" Margin="0,0,0,12" Style="{StaticResource PanelBorderStyle}">
            <WrapPanel>
                <DatePicker Width="150" Margin="0,0,8,0" SelectedDate="{Binding DateFrom}" />
                <DatePicker Width="150" Margin="0,0,8,0" SelectedDate="{Binding DateTo}" />
                <ComboBox Width="180" Margin="0,0,8,0" ItemsSource="{Binding TransactionTypes}" SelectedItem="{Binding TransactionType}" />
                <controls:PrimaryButton Command="{Binding SearchCommand}" Content="Search" Icon="S" />
            </WrapPanel>
        </Border>
        <Grid Grid.Row="2">
            <controls:AppDataGrid ItemsSource="{Binding Transactions}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Date, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Header="Date" Width="*" />
                    <DataGridTextColumn Binding="{Binding ProductTitle}" Header="Product" Width="2*" />
                    <DataGridTextColumn Binding="{Binding TransactionType}" Header="Transaction Type" Width="*" />
                    <DataGridTextColumn Binding="{Binding QuantityChange}" Header="Quantity Change" Width="*" />
                    <DataGridTextColumn Binding="{Binding QuantityBefore}" Header="Quantity Before" Width="*" />
                    <DataGridTextColumn Binding="{Binding QuantityAfter}" Header="Quantity After" Width="*" />
                    <DataGridTextColumn Binding="{Binding Reference}" Header="Reference" Width="*" />
                    <DataGridTextColumn Binding="{Binding User}" Header="User" Width="*" />
                    <DataGridTextColumn Binding="{Binding Notes}" Header="Notes" Width="2*" />
                </DataGrid.Columns>
            </controls:AppDataGrid>
            <controls:LoadingOverlay IsBusy="{Binding IsBusy}" Message="Loading stock ledger..." />
        </Grid>
        <Border Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource PanelBorderStyle}">
            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}">
                <Run Text="Page " /><Run Text="{Binding PageNumber}" />
                <Run Text=" | Page size " /><Run Text="{Binding PageSize}" />
                <Run Text=" | Total " /><Run Text="{Binding TotalCount}" />
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
