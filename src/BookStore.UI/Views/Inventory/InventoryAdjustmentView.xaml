<UserControl x:Class="BookStore.UI.Views.Inventory.InventoryAdjustmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BookStore.UI.Controls">
    <controls:AppCard Width="680" HorizontalAlignment="Left" Title="Stock Adjustment" Subtitle="Every change writes a stock ledger entry." Icon="A">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Product" />
            <ComboBox DisplayMemberPath="Title" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" />
            <TextBlock Margin="0,14,0,6" Style="{StaticResource SectionTitleTextStyle}" Text="Adjustment Type" />
            <ComboBox ItemsSource="{Binding TransactionTypes}" SelectedItem="{Binding AdjustmentType}" />
            <UniformGrid Margin="0,14,0,0" Columns="3">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Before" />
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding QuantityBefore}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="After" />
                    <controls:NumericTextBox Text="{Binding TargetQuantity, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="Reason" />
                    <controls:TextInputBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </UniformGrid>
            <TextBlock Margin="0,14,0,6" Style="{StaticResource SectionTitleTextStyle}" Text="Notes" />
            <controls:TextInputBox Height="90" AcceptsReturn="True" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource DangerBrush}" Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
            <StackPanel Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <controls:SecondaryButton Margin="0,0,8,0" Command="{Binding CancelCommand}" Content="Cancel" Icon="X" />
                <controls:PrimaryButton Command="{Binding SaveCommand}" Content="Save" Icon="S" IsLoading="{Binding IsBusy}" />
            </StackPanel>
        </StackPanel>
    </controls:AppCard>
</UserControl>
