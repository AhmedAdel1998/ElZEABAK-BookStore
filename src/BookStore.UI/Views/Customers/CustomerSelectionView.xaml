<UserControl x:Class="BookStore.UI.Views.Customers.CustomerSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BookStore.UI.Controls">
    <Border Padding="12" Style="{StaticResource PanelBorderStyle}">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Width="72" Margin="8,0,0,0" Command="{Binding SearchCommand}" Content="Search" />
                    <controls:SearchBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock FontWeight="SemiBold" Text="Create Customer" />
                <TextBox Margin="0,6,0,0" Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Margin="0,6,0,0" Text="{Binding NewCustomerPhone, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Margin="0,6,0,0" Text="{Binding NewCustomerEmail, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <Button Width="92" Command="{Binding CreateNewCustomerCommand}" Content="Create" />
                    <Button Width="92" Margin="8,0,0,0" Command="{Binding ClearSelectionCommand}" Content="Walk-in" />
                    <Button Width="92" Margin="8,0,0,0" Command="{Binding CancelCommand}" Content="Cancel" />
                </StackPanel>
            </StackPanel>
            <ListBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}">
                <ListBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SelectCommand}" />
                    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
                </ListBox.InputBindings>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4">
                            <TextBlock FontWeight="SemiBold" Text="{Binding FullName}" />
                            <TextBlock FontSize="12" Opacity="0.7" Text="{Binding Phone}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
