<UserControl x:Class="BookStore.UI.Views.DataQuality.DataQualityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BookStore.UI.Controls">
    <Grid Margin="{StaticResource Space24}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Data Quality" />

        <WrapPanel Grid.Row="1" Margin="0,16,0,16">
            <TextBlock Margin="0,7,8,0" Text="Minimum margin %" />
            <TextBox Width="80" Margin="0,0,8,0" Text="{Binding MinimumMarginPercent, UpdateSourceTrigger=PropertyChanged}" />
            <controls:PrimaryButton Margin="0,0,16,0" Command="{Binding RefreshCommand}" Content="Run Checks" Icon="Refresh" />
            <!-- Label and value are separate runs because a binding's StringFormat cannot take a
                 DynamicResource, which left these four captions untranslated in Arabic. -->
            <TextBlock Margin="0,7,16,0">
                <Run Text="{DynamicResource DataQuality.Issues}" />
                <Run Text="{Binding Summary.TotalIssues, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Margin="0,7,16,0">
                <Run Text="{DynamicResource DataQuality.MissingSupplier}" />
                <Run Text="{Binding Summary.MissingSupplierCount, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Margin="0,7,16,0">
                <Run Text="{DynamicResource DataQuality.InvalidPrice}" />
                <Run Text="{Binding Summary.InvalidPriceCount, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Margin="0,7,16,0">
                <Run Text="{DynamicResource DataQuality.NegativeStock}" />
                <Run Text="{Binding Summary.NegativeStockCount, Mode=OneWay}" />
            </TextBlock>
        </WrapPanel>

        <DataGrid Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto" ItemsSource="{Binding Issues}">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Severity}" Header="Severity" Width="90" />
                <DataGridTextColumn Binding="{Binding Area}" Header="Area" Width="120" />
                <DataGridTextColumn Binding="{Binding Issue}" Header="Issue" Width="180" />
                <DataGridTextColumn Binding="{Binding EntityName}" Header="Item" Width="220" />
                <DataGridTextColumn Binding="{Binding Recommendation}" Header="Recommendation" Width="*" MinWidth="110" />
            </DataGrid.Columns>
        </DataGrid>
        <controls:NoDataView Grid.Row="2"
                            Title="Data Quality"
                            Message="No records found."
                            Visibility="{Binding Issues.Count, Converter={StaticResource EmptyCollectionToVisibilityConverter}}" />
    </Grid>
</UserControl>
