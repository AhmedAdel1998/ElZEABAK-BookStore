<UserControl x:Class="BookStore.UI.Views.Suppliers.SupplierEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BookStore.UI.Controls">
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </UserControl.InputBindings>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="820" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{Binding Title}" />
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="Maintain supplier company, contact, address, and notes." />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <controls:SecondaryButton Margin="0,0,8,0" Command="{Binding ResetCommand}" Content="Reset" Icon="Reset" />
                    <controls:SecondaryButton Margin="0,0,8,0" Command="{Binding CancelCommand}" Content="Cancel" Icon="Cancel" IsCancel="True" />
                    <controls:PrimaryButton Command="{Binding SaveCommand}" Content="Save" Icon="Save" IsDefault="True" />
                </StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="Company Name" />
                    <TextBox Grid.Column="1" Margin="0,0,0,10" Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Contact Name" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Phone" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Email" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="4" VerticalAlignment="Top" Margin="0,4,0,0" Text="Address" />
                    <TextBox Grid.Row="4" Grid.Column="1" Height="84" Margin="0,0,0,10" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="5" VerticalAlignment="Top" Margin="0,4,0,0" Text="Notes" />
                    <TextBox Grid.Row="5" Grid.Column="1" Height="120" Margin="0,0,0,10" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Status" />
                    <CheckBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,10" Content="Active" IsChecked="{Binding IsActive}" />
                    <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Foreground="{DynamicResource DangerBrush}" Text="{Binding ValidationMessage, Converter={StaticResource LocalizeConverter}}" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
