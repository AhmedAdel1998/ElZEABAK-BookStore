<UserControl x:Class="BookStore.UI.Views.Sales.POSView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:BookStore.UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1180">
    <UserControl.InputBindings>
        <KeyBinding Key="F2" Command="{Binding StartSaleCommand}" />
        <KeyBinding Key="F3" Command="{Binding SuspendSaleCommand}" />
        <KeyBinding Key="F4" Command="{Binding CloseInvoiceCommand}" />
        <KeyBinding Key="F8" Command="{Binding PayExactCommand}" />
        <KeyBinding Key="F9" Command="{Binding CompleteSaleCommand}" />
        <KeyBinding Key="Delete" Command="{Binding RemoveSelectedItemCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelSaleCommand}" />
    </UserControl.InputBindings>
    <Grid Background="{DynamicResource BookstorePageBrush}"
          FlowDirection="{DynamicResource AppFlowDirection}"
          FocusManager.FocusedElement="{Binding ElementName=BarcodeInput}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14"
                Background="{DynamicResource WarmChromeBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True"
                       FlowDirection="{DynamicResource AppFlowDirection}">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrandOnChromeTextBrush}"
                                   Text="{DynamicResource POS.Cashier}" />
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBlock Foreground="{DynamicResource BrandOnChromeTextBrush}" Opacity="0.9" Text="{Binding CurrentSale.InvoiceNumber}" />
                        <TextBlock Margin="12,0,0,0" Foreground="{DynamicResource BrandOnChromeTextBrush}" Opacity="0.9" Text="{Binding CurrentSale.CustomerName, Converter={StaticResource LocalizeConverter}}" />
                        <TextBlock Margin="6,0,0,0" Foreground="{DynamicResource BrandOnChromeTextBrush}" Opacity="0.9" Text="{Binding CurrentSale.CustomerPhone}" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource BrandOnChromeTextBrush}"
                               Opacity="0.95"
                               Text="{Binding CartSummaryText}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button Margin="8,0,0,0"
                            Padding="14,8"
                            Command="{Binding StartSaleCommand}"
                           
                            Content="{DynamicResource POS.NewInvoice}" />
                    <Button Margin="8,0,0,0"
                            Padding="14,8"
                            Command="{Binding SuspendSaleCommand}"
                           
                            Content="{DynamicResource POS.Suspend}" />
                    <Button Margin="8,0,0,0"
                            Padding="14,8"
                            Command="{Binding CancelSaleCommand}"
                           
                            Content="{DynamicResource POS.Cancel}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--
            The open invoice strip. Several invoices are alive at once; this is the only place that
            says which they are and which one the screen below is editing, so it stays visible rather
            than living in a menu.
        -->
        <Border Grid.Row="1"
                Padding="10,6"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True"
                       FlowDirection="{DynamicResource AppFlowDirection}">
                <TextBlock DockPanel.Dock="Left"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Text="{DynamicResource POS.OpenInvoices}" />
                <TextBlock DockPanel.Dock="Right"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{Binding OpenInvoicesText}" />
                <ListBox BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ItemsSource="{Binding OpenInvoices}"
                         SelectedItem="{Binding SelectedOpenInvoice}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <!-- Without this the container reports its data type to assistive technology,
                         so the tab announced "SaleSessionDto" instead of the invoice number. -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding InvoiceNumber}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="4,2"
                                       MinWidth="150"
                                       ToolTip="{DynamicResource POS.SwitchInvoice}">
                                <Button DockPanel.Dock="Right"
                                        Width="24"
                                        Height="24"
                                        Margin="8,0,0,0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.CloseInvoiceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{DynamicResource POS.CloseInvoice}"
                                        ToolTip="{DynamicResource POS.CloseInvoice}"
                                        Content="&#x2715;" />
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               FlowDirection="LeftToRight"
                                               Text="{Binding InvoiceNumber}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11"
                                               Opacity="0.75">
                                        <Run Text="{Binding Items.Count, Mode=OneWay}" />
                                        <Run Text=" | " />
                                        <Run Text="{Binding Summary.GrandTotal, Mode=OneWay, StringFormat={}{0:N2}}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2"
              Margin="0">
            <Grid.ColumnDefinitions>
                <!--
                    Proportional with bounds rather than hard pixels. 300 + 310 fixed left the cart
                    roughly 350px at the window minimum, which collapsed the star-sized product
                    column to nothing while eight numeric columns kept their pixels.

                    The minimums total 730 rather than 840. At 840 the three columns could not fit
                    the width left by the shell at the window minimum, and the overflow fell off the
                    end of the page, taking the payment panel and Complete Sale with it.
                -->
                <ColumnDefinition Width="0.24*" MinWidth="215" MaxWidth="340" />
                <ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="0.26*" MinWidth="255" MaxWidth="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <!--
                    A DockPanel gave the top and bottom children their full desired height and left
                    the fill child (the product results list) with nothing, so the main way of adding
                    an item without a scanner silently disappeared. A three-row grid with a minimum
                    on the results row guarantees it space, and the top block scrolls if it cannot fit.
                -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" MaxHeight="330" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="{DynamicResource POS.Scan}" />
                        <DockPanel Margin="0,8,0,14">
                            <Button DockPanel.Dock="Right"
                                    Width="72"
                                    Margin="8,0,0,0"
                                    Command="{Binding AddBarcodeCommand}"
                                   
                                    Content="{DynamicResource POS.Add}" />
                            <TextBox x:Name="BarcodeInput"
                                     MinHeight="{DynamicResource ControlHeight}"
                                     FlowDirection="LeftToRight"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="{DynamicResource POS.Scan}"
                                     KeyUp="OnBarcodeKeyUp"
                                     Text="{Binding BarcodeText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddScannedBarcodeCommand}" />
                                    <KeyBinding Key="Enter" Command="{Binding AddScannedBarcodeCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                        <CheckBox Margin="0,0,0,8"
                                  Content="{DynamicResource POS.AutoAdd}"
                                  IsChecked="{Binding AutoAddScans}" />
                        <Border Margin="0,0,0,14"
                                Padding="10"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Text="{Binding LastScanMessage}" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Opacity="0.72">
                                    <Run Text="{DynamicResource POS.Category}" />
                                    <Run Text="{Binding LastScanCategory}" />
                                </TextBlock>
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Opacity="0.72"
                                           Text="{Binding LastScanDestination}" />
                            </StackPanel>
                        </Border>

                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="{DynamicResource POS.Search}" />
                        <DockPanel Margin="0,8,0,10">
                            <Button DockPanel.Dock="Right"
                                    Width="72"
                                    Margin="8,0,0,0"
                                    Command="{Binding SearchProductsCommand}"
                                    Content="{DynamicResource POS.Find}" />
                            <TextBox MinHeight="{DynamicResource ControlHeight}"
                                     FlowDirection="{DynamicResource AppFlowDirection}"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <TextBlock Margin="0,10,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="{DynamicResource POS.Customer}" />
                        <DockPanel Margin="0,8,0,8">
                            <Button DockPanel.Dock="Right"
                                    Width="72"
                                    Margin="8,0,0,0"
                                    Command="{Binding SearchCustomersCommand}"
                                    Content="{DynamicResource POS.Find}" />
                            <TextBox MinHeight="{DynamicResource ControlHeight}"
                                     FlowDirection="{DynamicResource AppFlowDirection}"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <ListBox Height="110"
                                 ItemsSource="{Binding CustomerResults}"
                                 SelectedItem="{Binding SelectedCustomer}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding FullName}" />
                                        <TextBlock FontSize="12" Opacity="0.7" Text="{Binding Phone}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Button Width="82" Command="{Binding SelectCustomerCommand}" Content="{DynamicResource POS.Select}" />
                            <Button Width="82" Margin="8,0,0,0" Command="{Binding ClearCustomerCommand}" Content="{DynamicResource POS.WalkIn}" />
                        </StackPanel>
                        <TextBox Margin="0,10,0,0"
                                 MinHeight="{DynamicResource ControlHeight}"
                                 FlowDirection="{DynamicResource AppFlowDirection}"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Margin="0,6,0,0"
                                 MinHeight="{DynamicResource ControlHeight}"
                                 FlowDirection="LeftToRight"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding NewCustomerPhone, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Margin="0,8,0,14"
                                Padding="12,6"
                                Command="{Binding CreateCustomerFromPosCommand}"
                                Content="{DynamicResource POS.CreateCustomer}" />
                    </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2"
                                Margin="0,12,0,0">
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="{DynamicResource POS.SelectedQuantity}" />
                        <DockPanel Margin="0,8,0,0">
                            <TextBox Width="68"
                                     MinHeight="{DynamicResource ControlHeight}"
                                     FlowDirection="LeftToRight"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ItemQuantity, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Margin="8,0,0,0"
                                    Padding="12,6"
                                    Command="{Binding AddSelectedProductCommand}"
                                    Content="{DynamicResource POS.AddProduct}" />
                        </DockPanel>
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             Margin="0,10,0,0"
                             ItemsSource="{Binding SearchResults}"
                             SelectedItem="{Binding SelectedProduct}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1"
                                               FontSize="12"
                                               Opacity="0.7">
                                        <Run Text="{Binding Barcode}" />
                                        <Run Text=" | " />
                                        <Run Text="{Binding CategoryName}" />
                                        <Run Text=" | Qty " />
                                        <Run Text="{Binding AvailableQuantity}" />
                                        <Run Text=" | " />
                                        <Run Text="{Binding UnitPrice, StringFormat={}{0:N2}}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1"
                  Margin="14">
                <Grid.RowDefinitions>
                    <!--
                        MinHeight keeps the cart visible on a short screen. Without it the control
                        bar below (which wraps to two or three lines when narrow) took the whole
                        column and the cart grid was arranged at zero height: the cashier could see
                        neither what had been scanned nor the line they were about to change.
                    -->
                    <RowDefinition Height="*" MinHeight="130" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HorizontalScrollBarVisibility="Auto"
                          FlowDirection="{DynamicResource AppFlowDirection}"
                          ItemsSource="{Binding CurrentSale.Items}"
                          SelectedItem="{Binding SelectedCartItem}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="*"
                                            MinWidth="150"
                                            Binding="{Binding Title}"
                                            Header="{DynamicResource POS.Product}" />
                        <DataGridTextColumn Width="Auto"
                                            MinWidth="90"
                                            Binding="{Binding CategoryName}"
                                            Header="{DynamicResource POS.CategoryColumn}" />
                        <DataGridTextColumn Width="Auto"
                                            MinWidth="90"
                                            Binding="{Binding Barcode}"
                                            Header="{DynamicResource POS.Barcode}" />
                        <DataGridTextColumn Width="Auto"
                                            MinWidth="56"
                                            Binding="{Binding Quantity}"
                                            Header="{DynamicResource POS.Qty}" />
                        <DataGridTextColumn Width="Auto"
                                            MinWidth="72"
                                            Binding="{Binding AvailableQuantity}"
                                            Header="{DynamicResource POS.StockLeft}" />
                        <DataGridTextColumn Width="Auto"
                                            MinWidth="78"
                                            Binding="{Binding UnitPrice, StringFormat=N2}"
                                            Header="{DynamicResource POS.Price}" />
                        <DataGridTextColumn Width="Auto"
                                            MinWidth="78"
                                            Binding="{Binding Discount, StringFormat=N2}"
                                            Header="{DynamicResource POS.Discount}" />
                        <DataGridTextColumn Width="Auto"
                                            MinWidth="66"
                                            Binding="{Binding Tax, StringFormat=N2}"
                                            Header="{DynamicResource POS.Tax}" />
                        <DataGridTextColumn Width="Auto"
                                            MinWidth="88"
                                            Binding="{Binding LineTotal, StringFormat=N2}"
                                            Header="{DynamicResource POS.Total}" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1"
                        Margin="0,12,0,0"
                        Padding="12"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <WrapPanel>
                            <Button Width="38"
                                    Padding="0"
                                    Command="{Binding DecreaseQuantityCommand}"
                                    AutomationProperties.Name="{DynamicResource POS.DecreaseQty}"
                                    ToolTip="{DynamicResource POS.DecreaseQty}"
                                    Content="{DynamicResource POS.DecreaseQty}" />
                            <TextBox Width="70"
                                     MinHeight="{DynamicResource ControlHeight}"
                                     Margin="8,0,0,0"
                                     FlowDirection="LeftToRight"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ItemQuantity, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Width="38"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    Command="{Binding IncreaseQuantityCommand}"
                                    AutomationProperties.Name="{DynamicResource POS.IncreaseQty}"
                                    ToolTip="{DynamicResource POS.IncreaseQty}"
                                    Content="{DynamicResource POS.IncreaseQty}" />
                            <Button Margin="8,0,0,0"
                                    Padding="12,6"
                                    Command="{Binding UpdateQuantityCommand}"
                                    Content="{DynamicResource POS.UpdateQty}" />
                            <TextBox Width="90"
                                     MinHeight="{DynamicResource ControlHeight}"
                                     Margin="18,0,0,0"
                                     FlowDirection="LeftToRight"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding LineDiscount, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Margin="8,0,0,0"
                                    Padding="12,6"
                                    Command="{Binding ApplyLineDiscountCommand}"
                                    Content="{DynamicResource POS.LineDiscount}" />
                            <Button Margin="18,0,0,0"
                                Padding="12,6"
                                Command="{Binding RemoveSelectedItemCommand}"
                                Content="{DynamicResource POS.Remove}" />
                    </WrapPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2"
                    Padding="14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <!--
                    Complete Sale is pinned to the bottom row and the payment detail scrolls above it.
                    Previously everything sat in one docked StackPanel, which put the most important
                    button in a point-of-sale system below the fold at 1366x768 with no scrollbar to
                    reach it.
                -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Text="{DynamicResource POS.Payment}" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <!-- A fixed gutter: Arabic labels are longer than the English ones and
                                     ran straight into the amounts without it. -->
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource POS.Subtotal}" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding CurrentSale.Summary.Subtotal, StringFormat=N2}" />
                            <TextBlock Grid.Row="1"
                                       Margin="0,8,0,0"
                                       Text="{DynamicResource POS.Discounts}" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       Margin="0,8,0,0"
                                       Text="{Binding CurrentSale.Summary.LineDiscount, StringFormat=N2}" />
                            <TextBlock Grid.Row="2"
                                       Margin="0,8,0,0"
                                       Text="{DynamicResource POS.InvoiceDiscount}" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="2"
                                       Margin="0,8,0,0"
                                       Text="{Binding CurrentSale.Summary.InvoiceDiscount, StringFormat=N2}" />
                            <TextBlock Grid.Row="3"
                                       Margin="0,8,0,0"
                                       Text="{DynamicResource POS.Tax}" />
                            <TextBlock Grid.Row="3"
                                       Grid.Column="2"
                                       Margin="0,8,0,0"
                                       Text="{Binding CurrentSale.Summary.Tax, StringFormat=N2}" />
                            <TextBlock Grid.Row="4"
                           Margin="0,14,0,0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="{DynamicResource POS.Total}" />
                            <TextBlock Grid.Row="4"
                                       Grid.Column="2"
                           Margin="0,14,0,0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="{Binding CurrentSale.Summary.GrandTotal, StringFormat=N2}" />
                            <TextBlock Grid.Row="5"
                                       Margin="0,8,0,0"
                                       FontWeight="SemiBold"
                                       Text="{DynamicResource POS.Change}" />
                            <TextBlock Grid.Row="5"
                                       Grid.Column="2"
                                       Margin="0,8,0,0"
                                       FontWeight="SemiBold"
                                       Text="{Binding CurrentSale.Summary.Change, StringFormat=N2}" />
                        </Grid>

                        <TextBlock Margin="0,18,0,6"
                                   Text="{DynamicResource POS.PaymentMethod}" />
                        <ComboBox MinHeight="{DynamicResource ControlHeight}"
                                  ItemsSource="{Binding PaymentMethods}"
                                  SelectedItem="{Binding SelectedPaymentMethod}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Margin="0,12,0,6"
                                   Text="{DynamicResource POS.AmountPaid}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Width="74"
                                    Margin="8,0,0,0"
                                    Command="{Binding PayExactCommand}"
                                   
                                    Content="{DynamicResource POS.PayExact}" />
                            <TextBox MinHeight="{DynamicResource ControlHeight}"
                                     FlowDirection="LeftToRight"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding AmountPaid, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Margin="0,8,0,6"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{DynamicResource POS.QuickCash}" />
                        <UniformGrid Columns="3">
                            <Button Margin="0,0,6,0" Command="{Binding AddQuickCashCommand}" CommandParameter="50" Content="50" />
                            <Button Margin="0,0,6,0" Command="{Binding AddQuickCashCommand}" CommandParameter="100" Content="100" />
                            <Button Command="{Binding AddQuickCashCommand}" CommandParameter="200" Content="200" />
                        </UniformGrid>
                        <TextBlock Margin="0,8,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding PaymentStatusText}" />
                        <TextBlock Margin="0,12,0,6"
                                   Text="{DynamicResource POS.ReceiptCopies}" />
                        <TextBox MinHeight="{DynamicResource ControlHeight}"
                                 FlowDirection="LeftToRight"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding ReceiptCopies, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,12,0,6"
                                   Text="{DynamicResource POS.InvoiceDiscount}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Width="74"
                                    Margin="8,0,0,0"
                                    Command="{Binding ApplyInvoiceDiscountCommand}"
                                    Content="{DynamicResource POS.Apply}" />
                            <TextBox MinHeight="{DynamicResource ControlHeight}"
                                     FlowDirection="LeftToRight"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding InvoiceDiscount, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Margin="0,12,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding StockAlertText, Converter={StaticResource LocalizeConverter}}"
                                   TextWrapping="Wrap" />
                        <GroupBox Margin="0,18,0,0"
                                  Header="{DynamicResource POS.HeldSales}">
                        <ListBox MaxHeight="190"
                                 ItemsSource="{Binding HeldSales}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <Button DockPanel.Dock="Right"
                                                Padding="8,4"
                                                Command="{Binding DataContext.ResumeSaleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Content="{DynamicResource POS.Resume}" />
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding InvoiceNumber}" />
                                            <TextBlock FontSize="12"
                                                       Opacity="0.7"
                                                       Text="{Binding Summary.GrandTotal, StringFormat=Total {0:N2}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </GroupBox>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- Always visible, whatever the window height. -->
                    <controls:PrimaryButton Grid.Row="2"
                                            Margin="0,14,0,0"
                                            MinHeight="48"
                                            Command="{Binding CompleteSaleCommand}"
                                           
                                            AutomationProperties.Name="{DynamicResource POS.CompleteSale}"
                                            Content="{DynamicResource POS.CompleteSale}" />
                </Grid>
            </Border>
        </Grid>

        <!-- POSView had no busy state at all, so nothing stopped a second tap on Complete Sale
             while the sale was committing and printing. -->
        <controls:LoadingOverlay Grid.RowSpan="3"
                                 IsBusy="{Binding IsBusy}"
                                 Message="{DynamicResource Loading.Default}" />
    </Grid>
</UserControl>
