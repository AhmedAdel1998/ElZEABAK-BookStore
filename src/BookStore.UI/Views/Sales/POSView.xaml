<UserControl x:Class="BookStore.UI.Views.Sales.POSView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1180">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="#D6DAE1"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="POS Cashier" />
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" Opacity="0.68" Text="{Binding CurrentSale.InvoiceNumber}" />
                        <TextBlock Margin="12,0,0,0" Foreground="{DynamicResource PrimaryTextBrush}" Opacity="0.68" Text="{Binding CurrentSale.CustomerName}" />
                        <TextBlock Margin="6,0,0,0" Foreground="{DynamicResource PrimaryTextBrush}" Opacity="0.68" Text="{Binding CurrentSale.CustomerPhone}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button Margin="8,0,0,0"
                            Padding="14,8"
                            Command="{Binding StartSaleCommand}"
                            Content="New Sale" />
                    <Button Margin="8,0,0,0"
                            Padding="14,8"
                            Command="{Binding SuspendSaleCommand}"
                            Content="Suspend" />
                    <Button Margin="8,0,0,0"
                            Padding="14,8"
                            Command="{Binding CancelSaleCommand}"
                            Content="Cancel" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1"
              Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="#D6DAE1"
                    BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="Scan" />
                        <DockPanel Margin="0,8,0,14">
                            <Button DockPanel.Dock="Right"
                                    Width="72"
                                    Margin="8,0,0,0"
                                    Command="{Binding AddBarcodeCommand}"
                                    Content="Add" />
                            <TextBox Height="34"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding BarcodeText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="Search" />
                        <DockPanel Margin="0,8,0,10">
                            <Button DockPanel.Dock="Right"
                                    Width="72"
                                    Margin="8,0,0,0"
                                    Command="{Binding SearchProductsCommand}"
                                    Content="Find" />
                            <TextBox Height="34"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <TextBlock Margin="0,10,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="Customer" />
                        <DockPanel Margin="0,8,0,8">
                            <Button DockPanel.Dock="Right"
                                    Width="72"
                                    Margin="8,0,0,0"
                                    Command="{Binding SearchCustomersCommand}"
                                    Content="Find" />
                            <TextBox Height="34"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <ListBox Height="110"
                                 ItemsSource="{Binding CustomerResults}"
                                 SelectedItem="{Binding SelectedCustomer}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding FullName}" />
                                        <TextBlock FontSize="12" Opacity="0.7" Text="{Binding Phone}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Button Width="82" Command="{Binding SelectCustomerCommand}" Content="Select" />
                            <Button Width="82" Margin="8,0,0,0" Command="{Binding ClearCustomerCommand}" Content="Walk-in" />
                        </StackPanel>
                        <TextBox Margin="0,10,0,0"
                                 Height="32"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Margin="0,6,0,0"
                                 Height="32"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding NewCustomerPhone, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Margin="0,8,0,14"
                                Padding="12,6"
                                Command="{Binding CreateCustomerFromPosCommand}"
                                Content="Create Customer" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom"
                                Margin="0,12,0,0">
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="Selected Quantity" />
                        <DockPanel Margin="0,8,0,0">
                            <TextBox Width="68"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ItemQuantity, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Margin="8,0,0,0"
                                    Padding="12,6"
                                    Command="{Binding AddSelectedProductCommand}"
                                    Content="Add Product" />
                        </DockPanel>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding SearchResults}"
                             SelectedItem="{Binding SelectedProduct}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1"
                                               FontSize="12"
                                               Opacity="0.7">
                                        <Run Text="{Binding Barcode}" />
                                        <Run Text=" | Qty " />
                                        <Run Text="{Binding AvailableQuantity}" />
                                        <Run Text=" | " />
                                        <Run Text="{Binding UnitPrice, StringFormat={}{0:N2}}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1"
                  Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding CurrentSale.Items}"
                          SelectedItem="{Binding SelectedCartItem}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="2*"
                                            Binding="{Binding Title}"
                                            Header="Product" />
                        <DataGridTextColumn Width="90"
                                            Binding="{Binding Barcode}"
                                            Header="Barcode" />
                        <DataGridTextColumn Width="70"
                                            Binding="{Binding Quantity}"
                                            Header="Qty" />
                        <DataGridTextColumn Width="90"
                                            Binding="{Binding UnitPrice, StringFormat=N2}"
                                            Header="Price" />
                        <DataGridTextColumn Width="90"
                                            Binding="{Binding Discount, StringFormat=N2}"
                                            Header="Discount" />
                        <DataGridTextColumn Width="80"
                                            Binding="{Binding Tax, StringFormat=N2}"
                                            Header="Tax" />
                        <DataGridTextColumn Width="100"
                                            Binding="{Binding LineTotal, StringFormat=N2}"
                                            Header="Total" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1"
                        Margin="0,12,0,0"
                        Padding="12"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="#D6DAE1"
                        BorderThickness="1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left"
                                    Orientation="Horizontal">
                            <TextBox Width="70"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ItemQuantity, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Margin="8,0,0,0"
                                    Padding="12,6"
                                    Command="{Binding UpdateQuantityCommand}"
                                    Content="Update Qty" />
                            <TextBox Width="90"
                                     Height="32"
                                     Margin="18,0,0,0"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding LineDiscount, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Margin="8,0,0,0"
                                    Padding="12,6"
                                    Command="{Binding ApplyLineDiscountCommand}"
                                    Content="Line Discount" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Padding="12,6"
                                Command="{Binding RemoveSelectedItemCommand}"
                                Content="Remove" />
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2"
                    Padding="14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="#D6DAE1"
                    BorderThickness="1,0,0,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Text="Payment" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Subtotal" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CurrentSale.Summary.Subtotal, StringFormat=N2}" />
                            <TextBlock Grid.Row="1"
                                       Margin="0,8,0,0"
                                       Text="Discounts" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Margin="0,8,0,0"
                                       Text="{Binding CurrentSale.Summary.LineDiscount, StringFormat=N2}" />
                            <TextBlock Grid.Row="2"
                                       Margin="0,8,0,0"
                                       Text="Invoice Discount" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Margin="0,8,0,0"
                                       Text="{Binding CurrentSale.Summary.InvoiceDiscount, StringFormat=N2}" />
                            <TextBlock Grid.Row="3"
                                       Margin="0,8,0,0"
                                       Text="Tax" />
                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       Margin="0,8,0,0"
                                       Text="{Binding CurrentSale.Summary.Tax, StringFormat=N2}" />
                            <TextBlock Grid.Row="4"
                                       Margin="0,14,0,0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Total" />
                            <TextBlock Grid.Row="4"
                                       Grid.Column="1"
                                       Margin="0,14,0,0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="{Binding CurrentSale.Summary.GrandTotal, StringFormat=N2}" />
                            <TextBlock Grid.Row="5"
                                       Margin="0,8,0,0"
                                       FontWeight="SemiBold"
                                       Text="Change" />
                            <TextBlock Grid.Row="5"
                                       Grid.Column="1"
                                       Margin="0,8,0,0"
                                       FontWeight="SemiBold"
                                       Text="{Binding CurrentSale.Summary.Change, StringFormat=N2}" />
                        </Grid>

                        <TextBlock Margin="0,18,0,6"
                                   Text="Payment Method" />
                        <ComboBox Height="32"
                                  ItemsSource="{Binding PaymentMethods}"
                                  SelectedItem="{Binding SelectedPaymentMethod}" />
                        <TextBlock Margin="0,12,0,6"
                                   Text="Amount Paid" />
                        <TextBox Height="32"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding AmountPaid, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,12,0,6"
                                   Text="Invoice Discount" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Width="74"
                                    Margin="8,0,0,0"
                                    Command="{Binding ApplyInvoiceDiscountCommand}"
                                    Content="Apply" />
                            <TextBox Height="32"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding InvoiceDiscount, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <Button Margin="0,18,0,0"
                                Height="42"
                                Command="{Binding CompleteSaleCommand}"
                                Content="Complete Sale" />
                    </StackPanel>

                    <GroupBox DockPanel.Dock="Bottom"
                              Margin="0,18,0,0"
                              Header="Held Sales">
                        <ListBox MaxHeight="190"
                                 ItemsSource="{Binding HeldSales}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <Button DockPanel.Dock="Right"
                                                Padding="8,4"
                                                Command="{Binding DataContext.ResumeSaleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Content="Resume" />
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding InvoiceNumber}" />
                                            <TextBlock FontSize="12"
                                                       Opacity="0.7"
                                                       Text="{Binding Summary.GrandTotal, StringFormat=Total {0:N2}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
