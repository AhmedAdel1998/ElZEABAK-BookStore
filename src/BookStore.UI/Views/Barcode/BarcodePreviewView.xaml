<UserControl x:Class="BookStore.UI.Views.Barcode.BarcodePreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BookStore.UI.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <controls:AppCard Title="Barcode" Subtitle="Generate, validate, and lookup products." Icon="B">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Barcode Value" />
                <controls:BarcodeTextBox Text="{Binding BarcodeValue, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,12,0,6" Style="{StaticResource SectionTitleTextStyle}" Text="Format" />
                <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" />
                <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                    <controls:PrimaryButton Margin="0,0,8,0" Command="{Binding GenerateCommand}" Content="Generate" Icon="G" />
                    <controls:SecondaryButton Margin="0,0,8,0" Command="{Binding ValidateCommand}" Content="Validate" Icon="V" />
                    <controls:SecondaryButton Command="{Binding FindProductCommand}" Content="Find" Icon="F" />
                </StackPanel>
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <controls:SecondaryButton Margin="0,0,8,0" Command="{Binding OpenPrintCommand}" Content="Labels" Icon="P" />
                    <controls:SecondaryButton Command="{Binding OpenSettingsCommand}" Content="Settings" Icon="S" />
                </StackPanel>
                <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
            </StackPanel>
        </controls:AppCard>
        <StackPanel Grid.Column="1" Margin="18,0,0,0">
            <controls:BarcodePreviewControl BarcodeValue="{Binding BarcodeValue}" Format="{Binding Format}" ProductTitle="{Binding ProductTitle}" />
            <controls:AppCard Margin="0,16,0,0" Title="Product Lookup" Icon="P">
                <StackPanel>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding ProductTitle}" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding SellingPrice, Converter={StaticResource CurrencyConverter}, StringFormat=Price: {0}}" />
                    <TextBlock Text="{Binding Quantity, StringFormat=Quantity: {0}}" />
                </StackPanel>
            </controls:AppCard>
        </StackPanel>
    </Grid>
</UserControl>
