<UserControl x:Class="BookStore.UI.Views.Barcode.BarcodeLabelPrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BookStore.UI.Controls"
             FlowDirection="LeftToRight">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:AppCard Title="Label Print" Subtitle="Prepare single, multi-label, or sheet output." Icon="Print">
                <StackPanel>
                    <TextBlock Text="Barcode" /><controls:BarcodeTextBox Text="{Binding BarcodeValue, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,10,0,0" Text="Product Title" /><controls:TextInputBox Text="{Binding ProductTitle, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,10,0,0" Text="Quantity" /><controls:NumericTextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,10,0,0" Text="Template" /><controls:TextInputBox Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                        <controls:SecondaryButton Margin="0,0,8,0" Command="{Binding AddLabelCommand}" Content="Add" Icon="Add" />
                        <controls:PrimaryButton Command="{Binding PrintCommand}" Content="Print" Icon="Print" />
                    </StackPanel>
                </StackPanel>
            </controls:AppCard>
            <controls:AppDataGrid Grid.Column="1" Margin="18,0,0,0" ItemsSource="{Binding Labels}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Barcode" Binding="{Binding BarcodeValue}" Width="*" />
                    <DataGridTextColumn Header="Product" Binding="{Binding ProductTitle}" Width="2*" />
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="*" />
                    <DataGridTextColumn Header="Template" Binding="{Binding Template}" Width="*" />
                </DataGrid.Columns>
            </controls:AppDataGrid>
            <controls:NoDataView
                                Title="Labels"
                                Message="No records found."
                                Visibility="{Binding Labels.Count, Converter={StaticResource EmptyCollectionToVisibilityConverter}}" />
        </Grid>
    </ScrollViewer>
</UserControl>
