<UserControl x:Class="BookStore.UI.Views.Login.FirstRunSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding CreateAdministratorCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ExitCommand}" />
    </UserControl.InputBindings>

    <Grid Background="{DynamicResource BookstorePageBrush}" FlowDirection="{DynamicResource AppFlowDirection}">
        <Button MinWidth="96"
                Margin="20"
                Padding="14,8"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Command="{Binding ToggleLanguageCommand}"
                Content="{Binding LanguageToggleText}" />
        <Border Width="460"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Effect="{DynamicResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,22">
                    <Border Width="64" Height="64" HorizontalAlignment="Center" Background="{DynamicResource BookstoreGoldBrush}" CornerRadius="8">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1E1711" FontSize="22" FontWeight="Bold" Text="BZ" />
                    </Border>
                    <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{DynamicResource Setup.CreateAdministrator}" />
                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="{DynamicResource Setup.Subtitle}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{DynamicResource Auth.Username}" />
                <TextBox Grid.Row="2" MinHeight="38" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="3" Margin="0,12,0,6" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{DynamicResource Setup.FullName}" />
                <TextBox Grid.Row="4" MinHeight="38" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="5" Margin="0,12,0,6" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{DynamicResource Setup.Email}" />
                <TextBox Grid.Row="6" MinHeight="38" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Grid.Row="7" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{DynamicResource Auth.Password}" />
                        <PasswordBox MinHeight="38" Padding="10,6" PasswordChanged="OnPasswordChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{DynamicResource Setup.ConfirmPassword}" />
                        <PasswordBox MinHeight="38" Padding="10,6" PasswordChanged="OnConfirmPasswordChanged" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="8" Margin="0,12,0,0" Foreground="{DynamicResource DangerBrush}" Text="{Binding ValidationMessage}" TextWrapping="Wrap" />

                <Grid Grid.Row="9" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding ExitCommand}" Content="{DynamicResource Auth.Exit}" />
                    <Button Grid.Column="2" Command="{Binding CreateAdministratorCommand}" Content="{DynamicResource Setup.CreateAdmin}" />
                </Grid>

                <Border Grid.RowSpan="10" Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="18" Text="{DynamicResource Setup.Creating}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
