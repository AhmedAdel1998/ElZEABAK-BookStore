<UserControl x:Class="BookStore.UI.Views.Login.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ExitCommand}" />
    </UserControl.InputBindings>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Border Width="420"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <Border Width="72" Height="72" CornerRadius="6" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="24" FontWeight="Bold" Text="BZ" />
                    </Border>
                    <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="EL ZEABAK BookStore" />
                    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Opacity="0.65" Text="BookStore POS v1.0" />
                </StackPanel>

                <TextBlock Grid.Row="1" Margin="0,0,0,6" Text="Username" />
                <TextBox Grid.Row="2"
                         MinHeight="38"
                         TabIndex="0"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="3" Margin="0,14,0,6" Text="Password" />
                <Grid Grid.Row="4">
                    <PasswordBox x:Name="PasswordInput"
                                 MinHeight="38"
                                 Padding="10,6"
                                 TabIndex="1"
                                 PasswordChanged="OnPasswordChanged" />
                    <TextBox MinHeight="38"
                             Padding="10,6"
                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ToggleButton Width="64"
                                  HorizontalAlignment="Right"
                                  Content="Show"
                                  IsChecked="{Binding IsPasswordVisible}"
                                  TabIndex="2" />
                </Grid>

                <Grid Grid.Row="5" Margin="0,16,0,0">
                    <CheckBox VerticalAlignment="Center" Content="Remember me" IsChecked="{Binding RememberMe}" TabIndex="3" />
                    <TextBlock HorizontalAlignment="Right" Foreground="#B91C1C" Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
                </Grid>

                <Grid Grid.Row="6" Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding ExitCommand}" Content="Exit" TabIndex="5" />
                    <Button Grid.Column="2" Command="{Binding LoginCommand}" Content="Login" TabIndex="4" />
                </Grid>

                <Border Background="#99000000"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="18" Text="Signing in..." />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
