<UserControl x:Class="BookStore.UI.Views.Login.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Storyboard x:Key="LoginEntranceStoryboard">
            <DoubleAnimation Storyboard.TargetName="BrandPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             Duration="0:0:0.45" />
            <DoubleAnimation Storyboard.TargetName="BrandPanelTransform"
                             Storyboard.TargetProperty="X"
                             From="-34"
                             To="0"
                             Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SignInCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             BeginTime="0:0:0.12"
                             Duration="0:0:0.38" />
            <DoubleAnimation Storyboard.TargetName="SignInCardTransform"
                             Storyboard.TargetProperty="Y"
                             From="28"
                             To="0"
                             BeginTime="0:0:0.12"
                             Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LogoScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.88"
                             To="1"
                             BeginTime="0:0:0.18"
                             Duration="0:0:0.42">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.25" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LogoScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.88"
                             To="1"
                             BeginTime="0:0:0.18"
                             Duration="0:0:0.42">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.25" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="AccentLine"
                             Storyboard.TargetProperty="Width"
                             From="0"
                             To="200"
                             BeginTime="0:0:0.28"
                             Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FeatureRail"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             BeginTime="0:0:0.38"
                             Duration="0:0:0.45" />
            <DoubleAnimation Storyboard.TargetName="FeatureRailTransform"
                             Storyboard.TargetProperty="Y"
                             From="22"
                             To="0"
                             BeginTime="0:0:0.38"
                             Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RightPulsePanel"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             BeginTime="0:0:0.3"
                             Duration="0:0:0.45" />
            <DoubleAnimation Storyboard.TargetName="RightPulseTransform"
                             Storyboard.TargetProperty="X"
                             From="34"
                             To="0"
                             BeginTime="0:0:0.3"
                             Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="LoginLoopStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ScanLineTransform"
                             Storyboard.TargetProperty="Y"
                             From="-150"
                             To="520"
                             Duration="0:0:3.8"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="ScanLine"
                             Storyboard.TargetProperty="Opacity"
                             From="0.05"
                             To="0.42"
                             AutoReverse="True"
                             Duration="0:0:1.9"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="LogoPulse"
                             Storyboard.TargetProperty="Opacity"
                             From="0.28"
                             To="0.78"
                             AutoReverse="True"
                             Duration="0:0:1.6"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="LogoScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1"
                             To="1.035"
                             AutoReverse="True"
                             BeginTime="0:0:0.75"
                             Duration="0:0:1.8"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="LogoScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1"
                             To="1.035"
                             AutoReverse="True"
                             BeginTime="0:0:0.75"
                             Duration="0:0:1.8"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="BarcodeSweepTransform"
                             Storyboard.TargetProperty="X"
                             From="-90"
                             To="260"
                             Duration="0:0:2.4"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="LiveDot"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25"
                             To="1"
                             AutoReverse="True"
                             Duration="0:0:0.85"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="FlowCardOneTransform"
                             Storyboard.TargetProperty="Y"
                             From="0"
                             To="-10"
                             AutoReverse="True"
                             Duration="0:0:2.6"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="FlowCardTwoTransform"
                             Storyboard.TargetProperty="Y"
                             From="0"
                             To="12"
                             AutoReverse="True"
                             BeginTime="0:0:0.4"
                             Duration="0:0:3.1"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="FlowCardThreeTransform"
                             Storyboard.TargetProperty="Y"
                             From="0"
                             To="-8"
                             AutoReverse="True"
                             BeginTime="0:0:0.75"
                             Duration="0:0:2.8"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="StatusBarFill"
                             Storyboard.TargetProperty="Width"
                             From="32"
                             To="148"
                             AutoReverse="True"
                             Duration="0:0:2.2"
                             RepeatBehavior="Forever" />
        </Storyboard>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ExitCommand}" />
    </UserControl.InputBindings>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource LoginEntranceStoryboard}" />
            <BeginStoryboard Storyboard="{StaticResource LoginLoopStoryboard}" />
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Background="{DynamicResource BookstorePageBrush}" FlowDirection="{DynamicResource AppFlowDirection}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="520" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Grid.ColumnSpan="3"
                MinWidth="96"
                Margin="20"
                Padding="14,8"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Command="{Binding ToggleLanguageCommand}"
                Content="{Binding LanguageToggleText}" />
        <Border x:Name="BrandPanel"
                Grid.Column="0"
                Background="{DynamicResource WarmChromeBrush}"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="BrandPanelTransform" />
            </Border.RenderTransform>
            <Grid Margin="48">
                <Grid ClipToBounds="True">
                    <Border Width="1"
                            HorizontalAlignment="Left"
                            Background="#334ADE80"
                            Opacity="0.55"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform X="292" />
                        </Border.RenderTransform>
                    </Border>
                    <Border x:Name="ScanLine"
                            Height="110"
                            VerticalAlignment="Top"
                            Background="#224ADE80"
                            Opacity="0.05">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ScanLineTransform" />
                        </Border.RenderTransform>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <Border Width="116"
                                Height="116"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource BookstoreGreenBrush}"
                                CornerRadius="10"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="LogoScale" />
                            </Border.RenderTransform>
                            <Grid>
                                <Border x:Name="LogoPulse"
                                        Margin="-8"
                                        BorderBrush="#884ADE80"
                                        BorderThickness="2"
                                        CornerRadius="14"
                                        Opacity="0.28" />
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#052E16"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Text="POS" />
                            </Grid>
                        </Border>
                        <TextBlock Margin="0,26,0,0" FontSize="36" FontWeight="SemiBold" Foreground="#BBF7D0" Text="EL ZEABAK" />
                        <TextBlock FontSize="22" Foreground="#DCFCE7" Text="{DynamicResource App.Product}" />
                        <Border x:Name="AccentLine"
                                Width="0"
                                Height="4"
                                Margin="0,24,0,18"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource BookstoreGreenBrush}"
                                CornerRadius="2" />
                        <TextBlock MaxWidth="340" Foreground="#F0FDF4" FontSize="14" Text="{DynamicResource Auth.SignInSubtitle}" TextWrapping="Wrap" />
                        <StackPanel x:Name="FeatureRail"
                                    Margin="0,28,0,0"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="FeatureRailTransform" />
                            </StackPanel.RenderTransform>
                            <WrapPanel MaxWidth="410">
                                <Border Margin="0,0,8,8" Padding="12,7" Background="#183E2A" BorderBrush="#336EE7A5" BorderThickness="1" CornerRadius="16">
                                    <TextBlock Foreground="#D1FAE5" FontSize="12" Text="Fast barcode scan" />
                                </Border>
                                <Border Margin="0,0,8,8" Padding="12,7" Background="#183E2A" BorderBrush="#336EE7A5" BorderThickness="1" CornerRadius="16">
                                    <TextBlock Foreground="#D1FAE5" FontSize="12" Text="Receipt ready" />
                                </Border>
                                <Border Margin="0,0,8,8" Padding="12,7" Background="#183E2A" BorderBrush="#336EE7A5" BorderThickness="1" CornerRadius="16">
                                    <TextBlock Foreground="#D1FAE5" FontSize="12" Text="Inventory guarded" />
                                </Border>
                            </WrapPanel>
                            <Grid Margin="0,18,0,0" MaxWidth="390">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Padding="14" Background="#142D20" BorderBrush="#245B3B" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Foreground="#86EFAC" FontSize="12" Text="Checkout" />
                                        <TextBlock Margin="0,4,0,0" Foreground="#F0FDF4" FontSize="22" FontWeight="SemiBold" Text="Ready" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Padding="14" Background="#142D20" BorderBrush="#245B3B" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Foreground="#86EFAC" FontSize="12" Text="Local database" />
                                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                            <Ellipse x:Name="LiveDot" Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" Fill="#22C55E" Opacity="0.25" />
                                            <TextBlock Foreground="#F0FDF4" FontSize="18" FontWeight="SemiBold" Text="Online" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Border x:Name="SignInCard"
                Grid.Column="1"
                Width="430"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Effect="{DynamicResource CardShadow}"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SignInCardTransform" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{DynamicResource Auth.SignIn}" />
                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="{DynamicResource Auth.SignInSubtitle}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{DynamicResource Auth.Username}" />
                <TextBox Grid.Row="2"
                         MinHeight="38"
                         TabIndex="0"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="3" Margin="0,14,0,6" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{DynamicResource Auth.Password}" />
                <Grid Grid.Row="4">
                    <PasswordBox x:Name="PasswordInput"
                                 MinHeight="38"
                                 Padding="10,6"
                                 TabIndex="1"
                                 PasswordChanged="OnPasswordChanged" />
                    <TextBox MinHeight="38"
                             Padding="10,6"
                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ToggleButton Width="64"
                                  HorizontalAlignment="Right"
                                  Content="{DynamicResource Auth.ShowPassword}"
                                  IsChecked="{Binding IsPasswordVisible}"
                                  TabIndex="2" />
                </Grid>

                <Grid Grid.Row="5" Margin="0,16,0,0">
                    <CheckBox VerticalAlignment="Center" Content="{DynamicResource Auth.RememberMe}" IsChecked="{Binding RememberMe}" TabIndex="3" />
                    <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource DangerBrush}" Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
                </Grid>

                <Grid Grid.Row="6" Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding ExitCommand}" Content="{DynamicResource Auth.Exit}" TabIndex="5" />
                    <Button Grid.Column="2" Command="{Binding LoginCommand}" Content="{DynamicResource Auth.Login}" TabIndex="4" />
                </Grid>

                <Border Background="{DynamicResource OverlayBrush}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="18" Text="{DynamicResource Auth.SigningIn}" />
                </Border>
            </Grid>
        </Border>
        <Grid x:Name="RightPulsePanel"
              Grid.Column="2"
              Margin="42,0,52,0"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="RightPulseTransform" />
            </Grid.RenderTransform>
            <StackPanel MaxWidth="390">
                <Border Padding="18"
                        Background="#F7FFF9"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Effect="{DynamicResource CardShadow}"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="FlowCardOneTransform" />
                    </Border.RenderTransform>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Live POS flow" />
                            <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Text="01" />
                        </DockPanel>
                        <Grid Height="54" Margin="0,16,0,0" ClipToBounds="True">
                            <StackPanel VerticalAlignment="Center">
                                <Rectangle Height="8" Margin="0,0,0,7" Fill="#052E16" />
                                <Rectangle Height="8" Margin="0,0,0,7" Fill="#052E16" />
                                <Rectangle Height="8" Width="180" HorizontalAlignment="Left" Fill="#052E16" />
                            </StackPanel>
                            <Border Width="42" Background="#664ADE80">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="BarcodeSweepTransform" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="Scan items, find prices, and prepare totals instantly." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="36,16,0,0"
                        Padding="16"
                        Background="#FFFFFF"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Effect="{DynamicResource CardShadow}"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="FlowCardTwoTransform" />
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Inventory protection" />
                        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="Stock is checked before checkout and reflected after sale." TextWrapping="Wrap" />
                        <Grid Height="7" Margin="0,14,0,0" Background="#DDFBE6">
                            <Border x:Name="StatusBarFill" Width="32" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" CornerRadius="4" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,44,0"
                        Padding="16"
                        Background="#FFFFFF"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Effect="{DynamicResource CardShadow}"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="FlowCardThreeTransform" />
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" Background="{DynamicResource BookstoreGreenBrush}" CornerRadius="8">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#052E16" Text="R" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Receipt and audit ready" />
                            <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="Every cashier session starts from a protected workspace." TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
