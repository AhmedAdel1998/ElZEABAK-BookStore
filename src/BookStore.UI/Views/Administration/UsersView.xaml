<UserControl x:Class="BookStore.UI.Views.Administration.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BookStore.UI.Controls">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="360" /></Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Left"><TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Users" /><TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="Manage accounts, access roles, lockouts, and active status." /></StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><controls:SecondaryButton Margin="0,0,8,0" Command="{Binding LoadCommand}" Content="Refresh" Icon="Refresh" /><controls:PrimaryButton Command="{Binding NewCommand}" Content="New User" Icon="Add" /></StackPanel>
            </DockPanel>
            <controls:AppDataGrid Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}" IsLoading="{Binding IsBusy}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*" />
                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="1.5*" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.5*" />
                    <DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="*" />
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70" />
                    <DataGridCheckBoxColumn Header="Locked" Binding="{Binding IsLockedOut}" Width="70" />
                </DataGrid.Columns>
            </controls:AppDataGrid>
        </Grid>
        <controls:AppCard Grid.Column="2" Title="Account Editor" Subtitle="A password is required for new users and for password resets." Icon="Users">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock Text="Username" /><controls:TextInputBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,10,0,0" Text="Full Name" /><controls:TextInputBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,10,0,0" Text="Email" /><controls:TextInputBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,10,0,0" Text="Role" /><ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedRoleId}" />
                <TextBlock Margin="0,10,0,0" Text="New Password" /><PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" />
                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="8+ characters with upper-case, lower-case, and a number." TextWrapping="Wrap" />
                <StackPanel Margin="0,16,0,0" Orientation="Horizontal"><controls:PrimaryButton Margin="0,0,8,0" Command="{Binding SaveCommand}" Content="Save" Icon="Save" /><controls:SecondaryButton Command="{Binding ResetPasswordCommand}" Content="Reset Password" Icon="Lock" /></StackPanel>
                <controls:SecondaryButton Margin="0,8,0,0" Command="{Binding ToggleActiveCommand}" Content="Activate / Deactivate Selected User" Icon="Users" />
            </StackPanel></ScrollViewer>
        </controls:AppCard>
    </Grid>
</UserControl>
