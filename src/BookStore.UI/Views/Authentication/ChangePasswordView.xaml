<UserControl x:Class="BookStore.UI.Views.Authentication.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Border Width="440"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="6">
            <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding Title}" />
                <TextBlock Margin="0,18,0,6" Text="Current Password" />
                <PasswordBox PasswordChanged="OnCurrentPasswordChanged" />
                <TextBlock Margin="0,14,0,6" Text="New Password" />
                <PasswordBox PasswordChanged="OnNewPasswordChanged" />
                <TextBlock Margin="0,14,0,6" Text="Confirm Password" />
                <PasswordBox PasswordChanged="OnConfirmPasswordChanged" />
                <TextBlock Margin="0,14,0,0" Foreground="#B91C1C" Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
                <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Margin="0,0,10,0" Command="{Binding CancelCommand}" Content="Cancel" />
                    <Button Command="{Binding SaveCommand}" Content="Save" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
