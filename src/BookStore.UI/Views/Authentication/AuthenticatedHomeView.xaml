<UserControl x:Class="BookStore.UI.Views.Authentication.AuthenticatedHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BookStore.UI.Controls"
             xmlns:categoryViews="clr-namespace:BookStore.UI.Views.Categories"
             xmlns:productViews="clr-namespace:BookStore.UI.Views.Products"
             xmlns:inventoryViews="clr-namespace:BookStore.UI.Views.Inventory"
             xmlns:barcodeViews="clr-namespace:BookStore.UI.Views.Barcode"
             xmlns:customerViews="clr-namespace:BookStore.UI.Views.Customers"
             xmlns:supplierViews="clr-namespace:BookStore.UI.Views.Suppliers"
             xmlns:salesViews="clr-namespace:BookStore.UI.Views.Sales"
             xmlns:reportViews="clr-namespace:BookStore.UI.Views.Reports"
             xmlns:receiptViews="clr-namespace:BookStore.UI.Views.Receipts"
             xmlns:backupViews="clr-namespace:BookStore.UI.Views.Backup"
             xmlns:auditViews="clr-namespace:BookStore.UI.Views.Audit"
             xmlns:dataQualityViews="clr-namespace:BookStore.UI.Views.DataQuality"
             xmlns:settingsViews="clr-namespace:BookStore.UI.Views.Settings"
             xmlns:administrationViews="clr-namespace:BookStore.UI.Views.Administration"
             xmlns:views="clr-namespace:BookStore.UI.Views.Shell"
             xmlns:viewModels="clr-namespace:BookStore.UI.ViewModels">
    <UserControl.Resources>
        <Storyboard x:Key="ShellEntranceAnimation">
            <DoubleAnimation Storyboard.TargetName="SidebarRoot"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             Duration="0:0:0.25" />
            <DoubleAnimation Storyboard.TargetName="SidebarTransform"
                             Storyboard.TargetProperty="X"
                             From="-18"
                             To="0"
                             Duration="0:0:0.32">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ShellContent"
                             Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             BeginTime="0:0:0.08"
                             Duration="0:0:0.28" />
            <DoubleAnimation Storyboard.TargetName="ContentTransform"
                             Storyboard.TargetProperty="Y"
                             From="14"
                             To="0"
                             BeginTime="0:0:0.08"
                             Duration="0:0:0.34">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="LogoLoopAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LogoHalo"
                             Storyboard.TargetProperty="Opacity"
                             From="0.18"
                             To="0.58"
                             AutoReverse="True"
                             Duration="0:0:1.8"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="LogoScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1"
                             To="1.045"
                             AutoReverse="True"
                             Duration="0:0:2.2"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="LogoScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1"
                             To="1.045"
                             AutoReverse="True"
                             Duration="0:0:2.2"
                             RepeatBehavior="Forever" />
        </Storyboard>

        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CategoryListViewModel}">
            <categoryViews:CategoryListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CategoryEditorViewModel}">
            <categoryViews:CategoryEditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CategoryDetailsViewModel}">
            <categoryViews:CategoryDetailsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ProductListViewModel}">
            <productViews:ProductListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ProductEditorViewModel}">
            <productViews:ProductEditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ProductDetailsViewModel}">
            <productViews:ProductDetailsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:InventoryDashboardViewModel}">
            <inventoryViews:InventoryDashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:InventoryListViewModel}">
            <inventoryViews:InventoryListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:InventoryAdjustmentViewModel}">
            <inventoryViews:InventoryAdjustmentView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:InventoryHistoryViewModel}">
            <inventoryViews:InventoryHistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:BarcodePreviewViewModel}">
            <barcodeViews:BarcodePreviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:BarcodeSettingsViewModel}">
            <barcodeViews:BarcodeSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:BarcodeLabelPrintViewModel}">
            <barcodeViews:BarcodeLabelPrintView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:POSViewModel}">
            <salesViews:POSView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CustomerListViewModel}">
            <customerViews:CustomerListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CustomerEditorViewModel}">
            <customerViews:CustomerEditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CustomerDetailsViewModel}">
            <customerViews:CustomerDetailsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SupplierListViewModel}">
            <supplierViews:SupplierListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SupplierEditorViewModel}">
            <supplierViews:SupplierEditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SupplierDetailsViewModel}">
            <supplierViews:SupplierDetailsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ReportsDashboardViewModel}">
            <reportViews:ReportsDashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SalesSummaryViewModel}">
            <reportViews:SalesSummaryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SalesDetailsViewModel}">
            <reportViews:SalesDetailsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ProfitReportViewModel}">
            <reportViews:ProfitReportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:BestSellingProductsViewModel}">
            <reportViews:BestSellingProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:InventoryReportViewModel}">
            <reportViews:InventoryReportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:InventoryMovementViewModel}">
            <reportViews:InventoryMovementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LowStockReportViewModel}">
            <reportViews:LowStockReportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CustomerReportViewModel}">
            <reportViews:CustomerReportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CashierPerformanceViewModel}">
            <reportViews:CashierPerformanceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PaymentMethodsViewModel}">
            <reportViews:PaymentMethodsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:DailySalesViewModel}">
            <reportViews:DailySalesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:HourlySalesViewModel}">
            <reportViews:HourlySalesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ReceiptPreviewViewModel}">
            <receiptViews:ReceiptPreviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ReprintReceiptViewModel}">
            <receiptViews:ReprintReceiptView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PrinterTestViewModel}">
            <receiptViews:PrinterTestView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <settingsViews:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:UsersViewModel}">
            <administrationViews:UsersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:RolesViewModel}">
            <administrationViews:RolesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:BackupViewModel}">
            <backupViews:BackupListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:BackupListViewModel}">
            <backupViews:BackupListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:BackupDetailsViewModel}">
            <backupViews:BackupDetailsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:BackupRestoreViewModel}">
            <backupViews:BackupRestoreView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AuditTrailViewModel}">
            <auditViews:AuditTrailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:DataQualityViewModel}">
            <dataQualityViews:DataQualityView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:DatabaseHealthViewModel}">
            <backupViews:DatabaseHealthView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ChangePasswordViewModel}">
            <views:ChangePasswordRegionView />
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding NavigateDashboardCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding NavigateProductsCommand}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding NavigateInventoryCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding NavigateSalesCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding NavigateReportsCommand}" />
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding NavigateBackupCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding LogoutCommand}" />
    </UserControl.InputBindings>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource ShellEntranceAnimation}" />
            <BeginStoryboard Storyboard="{StaticResource LogoLoopAnimation}" />
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Background="{DynamicResource BookstorePageBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding FirstColumnWidth}" />
            <ColumnDefinition Width="{Binding SecondColumnWidth}" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarRoot"
                Grid.Column="{Binding SidebarColumn}"
                Background="{DynamicResource WarmChromeBrush}"
                BorderBrush="{DynamicResource ChromeBorderBrush}"
                BorderThickness="0,0,1,0"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SidebarTransform" />
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="272" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                            <Setter Property="Width" Value="76" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        MinHeight="82"
                        Padding="14,16"
                        Background="{DynamicResource WarmChromeAltBrush}"
                        BorderBrush="{DynamicResource ChromeBorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44"
                                Height="44"
                                Background="{DynamicResource BookstoreBrandBrush}"
                                CornerRadius="8"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="LogoScale" />
                            </Border.RenderTransform>
                            <Grid>
                                <Border x:Name="LogoHalo"
                                        Margin="-5"
                                        BorderBrush="{DynamicResource BrandOnChromeTextBrush}"
                                        BorderThickness="1"
                                        CornerRadius="11"
                                        Opacity="0.18" />
                                <Path Width="27"
                                      Height="24"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 2,4 C 6,1.8 10,1.8 14,4 L 14,22 C 10,19.7 6,19.7 2,22 Z M 14,4 C 18,1.8 22,1.8 26,4 L 26,22 C 22,19.7 18,19.7 14,22 Z"
                                      Fill="#FFF8E1"
                                      Stretch="Fill"
                                      Stroke="{DynamicResource OnAccentTextBrush}"
                                      StrokeThickness="1.15" />
                                <Path Width="20"
                                      Height="12"
                                      Margin="0,4,0,0"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0,2 L 8,2 M 0,6 L 8,6 M 12,2 L 20,2 M 12,6 L 20,6"
                                      Stretch="Fill"
                                      Stroke="{DynamicResource OnAccentTextBrush}"
                                      StrokeEndLineCap="Round"
                                      StrokeThickness="1.1" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrandOnChromeTextBrush}"
                                       Text="EL ZEABAK" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="12"
                                       Foreground="#CCFFFFFF"
                                       Text="{DynamicResource App.Product}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Button DockPanel.Dock="Top"
                        Height="48"
                        Command="{Binding ToggleSidebarCommand}"
                        AutomationProperties.Name="{DynamicResource Shell.ToggleSidebar}"
                        ToolTip="{DynamicResource Shell.ToggleSidebar}"
                        Foreground="{DynamicResource BrandOnChromeTextBrush}"
                        Background="{DynamicResource WarmChromeAltBrush}"
                        BorderThickness="0">
                    <!--
                        The glyph has to be an explicit TextBlock carrying its own FontFamily. String
                        content is rendered by an implicit TextBlock, and the app-wide TextBlock style
                        in Typography.xaml sets FontFamily, and a style setter beats the family
                        inherited from this button, so the icon font never reached the glyph and the
                        hamburger drew as a missing-character box. Every other icon is written this way.
                    -->
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{DynamicResource BrandOnChromeTextBrush}"
                               Text="&#xE700;" />
                </Button>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding MenuItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="10,4"
                                        MinHeight="46"
                                        Padding="10,10"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding Command}"
                                        Foreground="White"
                                        BorderThickness="0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{DynamicResource WarmChromeAltBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Root"
                                                                Padding="{TemplateBinding Padding}"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="{DynamicResource CornerRadiusMedium}">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                              RecognizesAccessKey="True" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="Root" Property="Opacity" Value="0.86" />
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="Root" Property="Opacity" Value="0.52" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BookstoreBrandBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BrandOnChromeTextBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentTextBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="MenuItemTransform" />
                                        </Grid.RenderTransform>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="28"
                                                Height="28"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#18FFFFFF"
                                                BorderBrush="#24FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="15"
                                                       Text="{Binding Icon, Converter={StaticResource IconGlyphConverter}}" />
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Margin="10,0,10,0"
                                                   VerticalAlignment="Center"
                                                   FlowDirection="{DynamicResource AppFlowDirection}"
                                                   Text="{Binding Text}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="MenuItemTransform"
                                                                     Storyboard.TargetProperty="X"
                                                                     To="-4"
                                                                     Duration="0:0:0.12" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="MenuItemTransform"
                                                                     Storyboard.TargetProperty="X"
                                                                     To="0"
                                                                     Duration="0:0:0.14" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Button.Triggers>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid x:Name="ShellContent"
              Grid.Column="{Binding ContentColumn}"
              FlowDirection="{DynamicResource AppFlowDirection}"
              Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ContentTransform" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="20,10" Background="{DynamicResource ShellHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" MinWidth="240" VerticalAlignment="Center">
                        <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding Title}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" Opacity="0.65">
                            <Run Text="{Binding DisplayName, Mode=OneWay}" />
                            <Run Text=" • " />
                            <Run Text="{Binding Role, Mode=OneWay, Converter={StaticResource LocalizeConverter}}" />
                        </TextBlock>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <Grid Width="250" Margin="6,3">
                            <!--  Every keystroke reaches the view model, which debounces before it queries, so Enter always acts on the whole term.  -->
                            <controls:SearchBox x:Name="GlobalSearchBox"
                                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                ToolTip="{DynamicResource Shell.SearchTooltip}">
                                <controls:SearchBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding OpenTopSearchResultCommand}" />
                                    <KeyBinding Key="Escape" Command="{Binding CloseSearchResultsCommand}" />
                                </controls:SearchBox.InputBindings>
                            </controls:SearchBox>
                            <Popup AllowsTransparency="True"
                                   IsOpen="{Binding IsSearchResultsOpen, Mode=TwoWay}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=GlobalSearchBox}"
                                   StaysOpen="False">
                                <!--  A popup is its own visual tree root, so the shell's flow direction does not reach it on its own.  -->
                                <Border MinWidth="320"
                                        MaxWidth="420"
                                        Padding="6"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Effect="{DynamicResource PopupShadow}"
                                        FlowDirection="{DynamicResource AppFlowDirection}">
                                    <StackPanel>
                                        <TextBlock Margin="8,6"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Text="{Binding SearchStatus}"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SearchStatus}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Padding="8,6"
                                                                HorizontalContentAlignment="Stretch"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Command="{Binding DataContext.OpenSearchResultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel>
                                                                <TextBlock FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                                           Text="{Binding PrimaryText}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock FontSize="11"
                                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                                           Text="{Binding Caption}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <Button Margin="6,3" Command="{Binding ToggleLanguageCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0" FontFamily="Segoe MDL2 Assets" Text="&#xE774;" />
                                <TextBlock Text="{Binding LanguageToggleText}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="6,3" Command="{Binding ToggleThemeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0" FontFamily="Segoe MDL2 Assets" Text="&#xE790;" />
                                <TextBlock Text="{DynamicResource Shell.Theme}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="6,3" Command="{Binding ToggleNotificationsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0" FontFamily="Segoe MDL2 Assets" Text="&#xE7F4;" />
                                <TextBlock Text="{DynamicResource Shell.Notifications}" />
                                <TextBlock Margin="6,0,0,0" FontWeight="SemiBold" Text="{Binding NotificationCount}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="6,3" Command="{Binding ChangePasswordCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0" FontFamily="Segoe MDL2 Assets" Text="&#xE713;" />
                                <TextBlock Text="{DynamicResource Shell.Settings}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="6,3" Command="{Binding LogoutCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0" FontFamily="Segoe MDL2 Assets" Text="&#xE7E8;" />
                                <TextBlock Text="{DynamicResource Nav.Logout}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="18,0" FlowDirection="{DynamicResource AppFlowDirection}">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button MinWidth="44" MinHeight="44" Command="{Binding GoBackCommand}" AutomationProperties.Name="{DynamicResource Nav.Back}" ToolTip="{DynamicResource Nav.Back}">
                            <Viewbox Width="14" Height="14">
                                <Path Data="M 10,1 L 3,7 L 10,13"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="2" />
                            </Viewbox>
                        </Button>
                        <Button MinWidth="44" MinHeight="44" Margin="6,0,0,0" Command="{Binding GoForwardCommand}" AutomationProperties.Name="{DynamicResource Nav.Forward}" ToolTip="{DynamicResource Nav.Forward}">
                            <Viewbox Width="14" Height="14">
                                <Path Data="M 4,1 L 11,7 L 4,13"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="2" />
                            </Viewbox>
                        </Button>
                        <Button Width="94" Margin="8,0,8,0" Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0" FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" />
                                <TextBlock Text="{DynamicResource Shell.Refresh}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Margin="18,0,18,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding ShellNavigation.Breadcrumb}" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <ContentControl Margin="18" Content="{Binding ShellNavigation.CurrentViewModel}" />

                <controls:LoadingOverlay IsBusy="{Binding IsLoading}" Message="{Binding LoadingText, Converter={StaticResource LocalizeConverter}}" />

                <Border Width="360"
                        MaxHeight="420"
                        Margin="0,16,16,0"
                        Padding="14"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Effect="{DynamicResource PopupShadow}"
                        Visibility="{Binding IsNotificationsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel LastChildFill="True">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right"
                                    MinWidth="72"
                                    Padding="10,5"
                                    Command="{Binding ClearNotificationsCommand}"
                                    Content="{DynamicResource Shell.ClearNotifications}" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Text="{DynamicResource Shell.Notifications}" />
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{DynamicResource Shell.NoNotifications}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NotificationCount}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Notifications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="10"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                <TextBlock Margin="0,4,0,0" Text="{Binding Message, Converter={StaticResource LocalizeConverter}}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <ItemsControl Margin="0,16,16,0"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Visibility="{Binding IsNotificationsOpen, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                              ItemsSource="{Binding Notifications}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ToastNotificationStyle}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Message, Converter={StaticResource LocalizeConverter}}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Border Grid.Row="3" Background="{DynamicResource WarmChromeBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}" BorderThickness="0,1,0,0">
                <!--
                    LastChildFill has to be off here. With it on, the last child fills the leftover
                    space instead of honouring its Dock, so the version and clock were pinned
                    directly onto the end of the session text ("Tasks: 0v1.0") rather than sitting
                    at the far edge of the bar.
                -->
                <DockPanel Margin="12,0" LastChildFill="False">
                    <TextBlock VerticalAlignment="Center" Foreground="White">
                        <Run Text="{DynamicResource Shell.User}" />
                        <Run Text="{Binding DisplayName, Mode=OneWay}" />
                        <Run Text="{DynamicResource Shell.Database}" />
                        <Run Text="{Binding DatabaseStatus}" />
                        <Run Text="{DynamicResource Shell.Internet}" />
                        <Run Text="{Binding InternetStatus}" />
                        <Run Text="{DynamicResource Shell.Tasks}" />
                        <Run Text="{Binding PendingBackgroundTasks}" />
                    </TextBlock>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="White">
                        <Run Text="{Binding Version, Mode=OneWay}" />
                        <Run Text="   " />
                        <Run Text="{Binding CurrentTime}" />
                    </TextBlock>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
